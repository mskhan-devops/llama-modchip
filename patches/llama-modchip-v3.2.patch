+
+// Fractal-64 (GGML_TYPE_FRACTAL_64 = 44, 30 bytes / 64 weights):
+// magnitudes {1,4,8,14} packed in 0x0E080401; idx 0..3 -> -mag[3-idx], idx 4..7 -> +mag[idx-4].
+static inline float fractal_64_kval(uint idx) {
+    const bool neg = idx < 4u;
+    const uint j   = idx ^ (neg ? 3u : 4u);
+    const float m  = (float) ((0x0E080401u >> (8u*j)) & 0xFFu);
+    return neg ? -m : m;
+}
+
+static inline float fractal_64_mult(device const block_fractal_64 * xb, short sb) {
+    const uint8_t sc = xb->scales[sb & 3];
+    return (float)(4 + ((sb < 4) ? (sc & 0x0F) : (sc >> 4)));
+}
+
+static inline uint fractal_64_word(device const uint8_t * p) {
+    device const ushort * p16 = (device const ushort *) p;
+    return (uint) p16[0] | ((uint) p16[1] << 16);
+}
+
+template <typename type4x4>
+void dequantize_fractal_64(device const block_fractal_64 * xb, short il, thread type4x4 & reg) {
+    const float d  = xb->d;
+    const float s0 = d * fractal_64_mult(xb, 2*il + 0);
+    const float s1 = d * fractal_64_mult(xb, 2*il + 1);
+    const uint h0  = fractal_64_word(xb->qh);
+    const uint h1  = fractal_64_word(xb->qh + 4);
+
+    float4x4 reg_f;
+    FOR_UNROLL (short w = 0; w < 4; w++) {
+        const uint q   = fractal_64_word(xb->qs + 4*w);
+        const uint h   = (w & 1) ? h1 : h0;
+        const uint hs  = 2*il + (w >> 1);
+        const float s  = (w < 2) ? s0 : s1;
+        FOR_UNROLL (short t = 0; t < 4; t++) {
+            const uint lo2 = (q >> (8*t + 2*il)) & 3u;
+            const uint hi1 = (h >> (8*t + hs))   & 1u;
+            reg_f[w][t] = s * fractal_64_kval(lo2 | (hi1 << 2));
+        }
+    }
+
+    reg = (type4x4) reg_f;
+}
+
+template <typename type4>
+void dequantize_fractal_64_t4(device const block_fractal_64 * xb, short il, thread type4 & reg) {
+    const short g = il / 4;
+    const short w = il % 4;
+    const uint q  = fractal_64_word(xb->qs + 4*w);
+    const uint h  = fractal_64_word(xb->qh + 4*(w & 1));
+    const uint hs = 2*g + (w >> 1);
+    const float s = (float)xb->d * fractal_64_mult(xb, 2*g + (w >> 1));
+
+    float4 reg_f;
+    FOR_UNROLL (short t = 0; t < 4; t++) {
+        const uint lo2 = (q >> (8*t + 2*g)) & 3u;
+        const uint hi1 = (h >> (8*t + hs))  & 1u;
+        reg_f[t] = s * fractal_64_kval(lo2 | (hi1 << 2));
+    }
+
+    reg = (type4) reg_f;
+}
