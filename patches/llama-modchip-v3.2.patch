+
+    const rc2_modchip_shm_t * cur = shm_ptr.load(std::memory_order_acquire);
+    if (cur == nullptr && ((probe_tick.fetch_add(1, std::memory_order_relaxed) & 63u) == 0u)) {
+        std::lock_guard<std::mutex> lock(shm_mtx);
+        cur = shm_ptr.load(std::memory_order_relaxed);
+        if (cur == nullptr) {
+            int fd = -1;
+            const char * custom_shm = std::getenv("MODCHIP_SHM_PATH");
+            if (custom_shm && custom_shm[0]) {
+                fd = open(custom_shm, O_RDONLY | O_NOFOLLOW);
+            }
+            if (fd < 0) {
+                const char * xdg = std::getenv("XDG_RUNTIME_DIR");
+                if (xdg && xdg[0]) {
+                    char path_buf[512];
+                    std::snprintf(path_buf, sizeof(path_buf), "%s/llama_modchip.bin", xdg);
+                    fd = open(path_buf, O_RDONLY | O_NOFOLLOW);
+                }
+            }
+            if (fd < 0) {
+                char uid_buf[128];
+                std::snprintf(uid_buf, sizeof(uid_buf), "/dev/shm/llama_modchip_%u.bin", (unsigned) geteuid());
+                fd = open(uid_buf, O_RDONLY | O_NOFOLLOW);
+            }
+            if (fd >= 0) {
+                struct stat st;
+                if (fstat(fd, &st) == 0 &&
+                    S_ISREG(st.st_mode) &&
+                    st.st_size >= (off_t) sizeof(rc2_modchip_shm_t) &&
+                    st.st_uid == geteuid() &&
+                    (st.st_mode & 0022) == 0) {
+                    void * p = mmap(nullptr, sizeof(rc2_modchip_shm_t), PROT_READ, MAP_SHARED, fd, 0);
+                    if (p != MAP_FAILED) {
+                        const auto * s = reinterpret_cast<const rc2_modchip_shm_t *>(p);
+                        if (s->magic == 0x4D4F4443u) {
+                            cur = s;
+                            shm_ptr.store(s, std::memory_order_release);
+                        } else {
+                            munmap(p, sizeof(rc2_modchip_shm_t));
+                        }
+                    }
+                }
+                close(fd);
+            }
+        }
+    }
+    if (cur && cur->magic == 0x4D4F4443u) {
+        return cur;
+    }
+#endif
+    return nullptr;
+}
+
+static bool is_rc2_runtime_enabled() {
+    const char * e_dis = std::getenv("LLAMA_RC_DISABLE");
+    if (e_dis && e_dis[0] && std::atoi(e_dis) != 0) {
+        return false;
+    }
+    const char * e_en = std::getenv("LLAMA_RC_ENABLED");
+    if (e_en && e_en[0] && std::atoi(e_en) == 0) {
+        return false;
+    }
+    const rc2_modchip_shm_t * shm = get_rc2_modchip_shm();
+    if (shm && shm->rc_enabled == 0) {
+        return false;
+    }
+    return true;
+}
