+    int32_t  rc_enabled;       // 1 = RouteCrack on, 0 = off
+    int32_t  rc_cert_d0;       // Step 0 certainty gate (84 strict / 78 balanced)
+    int32_t  rc_cert_d1;       // Step 1 certainty gate (92 strict / 88 balanced)
+    int32_t  rc_cert_d2;       // Step 2 certainty gate (96 strict / 94 balanced)
+    int32_t  moe_top_k;        // Active MoE Top-K
+};
+
+struct kv_l3_policy_config {
+    int64_t kv_l3_window;
+    int64_t kv_nta_prefix;
+    int64_t attn_window;
+    int64_t attn_sinks;
+    int64_t swa_stride;
+    const volatile llama_modchip_shm_t * shm_ptr;
+
+    kv_l3_policy_config() : shm_ptr(nullptr) {
+        const char * env_w  = getenv("LLAMA_KV_L3_WINDOW");
+        kv_l3_window        = env_w ? atoll(env_w) : 2048;
+        const char * env_p  = getenv("LLAMA_KV_L3_NTA_PREFIX");
+        kv_nta_prefix       = env_p ? atoll(env_p) : -1;
+        const char * env_aw = getenv("LLAMA_ATTN_WINDOW");
+        attn_window         = env_aw ? atoll(env_aw) : 0;
+        const char * env_as = getenv("LLAMA_ATTN_SINKS");
+        attn_sinks          = env_as ? atoll(env_as) : 16;
+        const char * env_st = getenv("LLAMA_SWA_STRIDE");
+        swa_stride          = env_st ? atoll(env_st) : 0;
+
+#if defined(__linux__)
+        int fd = -1;
+        const char * custom_shm = getenv("MODCHIP_SHM_PATH");
+        if (custom_shm && custom_shm[0]) {
+            fd = open(custom_shm, O_RDONLY | O_NOFOLLOW);
+        }
+        if (fd < 0) {
+            const char * xdg = getenv("XDG_RUNTIME_DIR");
+            if (xdg && xdg[0]) {
+                char path_buf[512];
+                snprintf(path_buf, sizeof(path_buf), "%s/llama_modchip.bin", xdg);
+                fd = open(path_buf, O_RDONLY | O_NOFOLLOW);
+            }
+        }
+        if (fd < 0) {
+            char uid_buf[128];
+            snprintf(uid_buf, sizeof(uid_buf), "/dev/shm/llama_modchip_%u.bin", (unsigned)geteuid());
+            fd = open(uid_buf, O_RDONLY | O_NOFOLLOW);
+        }
+        if (fd >= 0) {
+            struct stat st;
+            if (fstat(fd, &st) == 0 &&
+                S_ISREG(st.st_mode) &&
+                st.st_size >= (off_t)sizeof(llama_modchip_shm_t) &&
+                st.st_uid == geteuid() &&
+                (st.st_mode & 0022) == 0) {
+                void * p = mmap(nullptr, sizeof(llama_modchip_shm_t), PROT_READ, MAP_SHARED, fd, 0);
+                if (p != MAP_FAILED) {
+                    const llama_modchip_shm_t * s = (const llama_modchip_shm_t *)p;
+                    if (s->magic == 0x4D4F4443u) {
+                        shm_ptr = s;
+                    } else {
+                        munmap(p, sizeof(llama_modchip_shm_t));
+                    }
+                }
+            }
+            close(fd);
+        }
+#endif
+
+        if (attn_window > 0) {
+            fprintf(stderr, "[GGML-MODCHIP] SWA ACTIVE: Window=%ld, Sinks=%ld, Stride=%ld, L3 Window=%ld\n",
+                    (long)attn_window, (long)attn_sinks, (long)swa_stride, (long)kv_l3_window);
+        } else {
+            fprintf(stderr, "[GGML-MODCHIP] Full 256K Global Attention ACTIVE: Window=FULL, L3 NTA Window=%ld\n",
+                    (long)kv_l3_window);
+        }
+    }
+};
+
+static inline const kv_l3_policy_config & get_kv_l3_policy() {
+    static const kv_l3_policy_config cfg;
+    return cfg;
+}
