+void ggml_vec_dot_iq1_s_q8_K_1x2(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__) && defined(__BMI2__)
+    const int nb = n / QK_K;
+    const block_iq1_s * GGML_RESTRICT x = (const block_iq1_s *)vx;
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *)vy[0];
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *)vy[1];
+    __m256 acc0 = _mm256_setzero_ps(); float acc1_0 = 0.0f;
+    __m256 acc1 = _mm256_setzero_ps(); float acc1_1 = 0.0f;
+    const __m512i zero512 = _mm512_setzero_si512();
+
+    for (int i = 0; i < nb; ++i) {
+        const float dx = GGML_CPU_FP16_TO_FP32(x[i].d);
+        const uint8_t  * qs = x[i].qs;
+        const uint16_t * qh = x[i].qh;
+        __m512i sumi0 = _mm512_setzero_si512(); int sumi1_0 = 0;
+        __m512i sumi1 = _mm512_setzero_si512(); int sumi1_1 = 0;
+        for (int ib = 0; ib < QK_K/32; ib += 2) {
+            const uint64_t packed_idx1 = _pdep_u64(*(const uint32_t *)qs, 0x00ff00ff00ff00ffULL) | _pdep_u64(qh[ib], 0x700070007000700ULL);
+            const uint64_t packed_idx2 = _pdep_u64(*(const uint32_t *)(qs + 4), 0x00ff00ff00ff00ffULL) | _pdep_u64(qh[ib + 1], 0x700070007000700ULL);
+            qs += 8;
+            const __m256i q1b_1 = _mm256_set_epi64x(iq1s_grid[(uint16_t)(packed_idx1 >> 48)], iq1s_grid[(uint16_t)(packed_idx1 >> 32)], iq1s_grid[(uint16_t)(packed_idx1 >> 16)], iq1s_grid[(uint16_t)packed_idx1]);
+            const __m256i q1b_2 = _mm256_set_epi64x(iq1s_grid[(uint16_t)(packed_idx2 >> 48)], iq1s_grid[(uint16_t)(packed_idx2 >> 32)], iq1s_grid[(uint16_t)(packed_idx2 >> 16)], iq1s_grid[(uint16_t)packed_idx2]);
+            const __m512i q1b_512 = _mm512_inserti64x4(_mm512_castsi256_si512(q1b_1), q1b_2, 1);
+            const __m512i q1_abs  = _mm512_abs_epi8(q1b_512);
+            const __mmask64 neg_m = _mm512_movepi8_mask(q1b_512);
+            const int16_t ls1 = 2*((qh[ib+0] >> 12) & 7) + 1;
+            const int16_t ls2 = 2*((qh[ib+1] >> 12) & 7) + 1;
+            const __m512i v_ls = _mm512_inserti64x4(_mm512_castsi256_si512(_mm256_set1_epi16(ls1)), _mm256_set1_epi16(ls2), 1);
+            const int dsign1 = (qh[ib+0] & 0x8000 ? -1 : 1) * ls1;
+            const int dsign2 = (qh[ib+1] & 0x8000 ? -1 : 1) * ls2;
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 32*ib));
+                const __m512i q8_s   = _mm512_mask_sub_epi8(q8_all, neg_m, zero512, q8_all);
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(_mm512_maddubs_epi16(q1_abs, q8_s), v_ls));
+                sumi1_0 += (y0[i].bsums[2*ib+0] + y0[i].bsums[2*ib+1]) * dsign1 + (y0[i].bsums[2*ib+2] + y0[i].bsums[2*ib+3]) * dsign2;
+            }
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 32*ib));
+                const __m512i q8_s   = _mm512_mask_sub_epi8(q8_all, neg_m, zero512, q8_all);
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(_mm512_maddubs_epi16(q1_abs, q8_s), v_ls));
+                sumi1_1 += (y1[i].bsums[2*ib+0] + y1[i].bsums[2*ib+1]) * dsign1 + (y1[i].bsums[2*ib+2] + y1[i].bsums[2*ib+3]) * dsign2;
+            }
+        }
+        {
+            const float d0 = y0[i].d * dx;
+            const __m256i s256_0 = _mm256_add_epi32(_mm512_castsi512_si256(sumi0), _mm512_extracti64x4_epi64(sumi0, 1));
+            acc0 = _mm256_fmadd_ps(_mm256_set1_ps(d0), _mm256_cvtepi32_ps(s256_0), acc0);
+            acc1_0 += d0 * sumi1_0;
+        }
+        {
+            const float d1 = y1[i].d * dx;
+            const __m256i s256_1 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1));
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(d1), _mm256_cvtepi32_ps(s256_1), acc1);
+            acc1_1 += d1 * sumi1_1;
+        }
+    }
+    s[0] = hsum_float_8(acc0) + IQ1S_DELTA * acc1_0;
+    s[1] = hsum_float_8(acc1) + IQ1S_DELTA * acc1_1;
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_iq1_s_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
