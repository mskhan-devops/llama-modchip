+        pred->logit_probe.hot_ids  = nullptr;
+        pred->logit_probe.feat_ids = nullptr;
+        pred->logit_probe.ready    = false;
+        pred->online_probe.init();
+        pred->ppm.clear();
+        pred->skipgram.clear();
+        pred->codebook.clear();
+        pred->macro.clear();
