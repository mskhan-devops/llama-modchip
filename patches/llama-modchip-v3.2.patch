+// Exact reference dequantize + dot parity test (< 1e-5 max relative error) for
+// Q1_0, signed-scale Q2_0 (both positive and negative FP16 scales d), Q8_0 (including -128),
+// MXFP4, and x86_64 1x8 / 1x4 / 1x3 / 1x2 multi-column kernels.
+static int test_vec_dot_dequant_exact(bool verbose) {
+    int num_failed = 0;
+    const size_t n = 512;
+
+    for (ggml_type type : {GGML_TYPE_Q1_0, GGML_TYPE_Q2_0, GGML_TYPE_Q8_0, GGML_TYPE_MXFP4}) {
+        ggml_quantize_init(type);
+        const auto * qfns     = ggml_get_type_traits(type);
+        const auto * qfns_cpu = ggml_get_type_traits_cpu(type);
+        const auto * vdot_fns = ggml_get_type_traits(qfns_cpu->vec_dot_type);
+        const auto * vdot_cpu = ggml_get_type_traits_cpu(qfns_cpu->vec_dot_type);
+
+        std::vector<float> x_f32(n);
+        generate_data(0.37f, n, x_f32.data(), 3.0f);
+        std::vector<uint8_t> vx(ggml_row_size(type, n));
+        qfns_cpu->from_float(x_f32.data(), vx.data(), n);
+
+        // Explicitly flip half of the Q2_0 block FP16 scales negative to verify signed-scale Q2_0
+        if (type == GGML_TYPE_Q2_0) {
+            auto * blocks = reinterpret_cast<block_q2_0 *>(vx.data());
+            const size_t nb = n / QK2_0;
+            for (size_t ib = 1; ib < nb; ib += 2) {
+                blocks[ib].d ^= 0x8000u;
+            }
+        } else if (type == GGML_TYPE_Q8_0) {
+            auto * blocks = reinterpret_cast<block_q8_0 *>(vx.data());
+            blocks[0].qs[0] = -128;
+            blocks[0].qs[1] = -128;
+        }
+
+        std::vector<float> x_deq(n);
+        qfns->to_float(vx.data(), x_deq.data(), n);
+
