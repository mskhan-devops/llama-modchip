+    const __m512i lut1_lo      = ggml_vq3_loadu_si512(ggml_vq3_lut1_lo); \
+    const __m512i lut1_hi      = ggml_vq3_loadu_si512(ggml_vq3_lut1_hi); \
+    const __m512i lut2_lo      = ggml_vq3_loadu_si512(ggml_vq3_lut2_lo); \
+    const __m512i lut2_hi      = ggml_vq3_loadu_si512(ggml_vq3_lut2_hi); \
+    const __m512i perm_rep64   = ggml_vq3_loadu_si512(ggml_vq3_perm_rep64); \
+    const __m512i shuf_mult512 = ggml_vq3_loadu_si512(ggml_vq3_shuf_mult512);
+
+#define GGML_VQ3_64_UNPACK_STEP(i) \
+    const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d) * GGML_VQ3_G; \
+    const __m512i raw_22 = _mm512_maskz_loadu_epi8(0x00000000003FFFFFULL, x[i].qs); \
+    const uint32_t s24 = (uint32_t)_mm512_movepi8_mask(raw_22) | \
+                         (((uint32_t)(x[i].qs[20] >> 6) & 1U) << 22) | \
+                         (((uint32_t)(x[i].qs[21] >> 6) & 1U) << 23); \
+    const uint64_t m_all = ggml_vq3_unpack_scales(s24); \
+    const __m512i vmult  = _mm512_shuffle_epi8(_mm512_set1_epi64((int64_t)m_all), shuf_mult512); \
+    __m512i t_idx        = _mm512_permutexvar_epi8(perm_rep64, raw_22); \
+    t_idx                = _mm512_mask2_permutex2var_epi8(lut1_lo, t_idx, 0x00000FFFFFC00000ULL, lut1_hi); \
+    t_idx                = _mm512_mask2_permutex2var_epi8(lut2_lo, t_idx, 0xFFFFF00000000000ULL, lut2_hi); \
+    const __m512i q_s8   = _mm512_mask2_permutex2var_epi8(lut0_lo, t_idx, 0x00000000003FFFFFULL, lut0_hi); \
+    const __m512i q_abs  = _mm512_abs_epi8(q_s8); \
+    const __mmask64 neg_mask = _mm512_movepi8_mask(q_s8);
+
+#define GGML_VQ3_64_DOT_COL(Y_PTR, ACC) \
+    do { \
+        const __m512 vd = _mm512_mask_broadcastss_ps( \
+            _mm512_set1_ps(d0 * GGML_CPU_FP16_TO_FP32((Y_PTR)[2 * i + 0].d)), 0xFF00, \
+            _mm_set_ss(d0 * GGML_CPU_FP16_TO_FP32((Y_PTR)[2 * i + 1].d))); \
+        const __m512i q8_all = _mm512_inserti64x4( \
+            _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *)(Y_PTR)[2 * i + 0].qs)), \
+            _mm256_loadu_si256((const __m256i *)(Y_PTR)[2 * i + 1].qs), 1); \
+        const __m512i q8_signed = _mm512_mask_sub_epi8(q8_all, neg_mask, zero512, q8_all); \
+        const __m512i p = _mm512_maddubs_epi16(q_abs, q8_signed); \
+        const __m512i s_i32 = _mm512_madd_epi16(p, vmult); \
+        (ACC) = _mm512_fmadd_ps(vd, _mm512_cvtepi32_ps(s_i32), (ACC)); \
+    } while (0)
+#endif
+
+void ggml_vec_dot_vq3_64_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n % QK_VQ3_64 == 0);
+    assert(nrc == 1);
+    UNUSED(nrc); UNUSED(bx); UNUSED(by); UNUSED(bs);
+    const int nb = n / QK_VQ3_64;
+    const block_vq3_64 * GGML_RESTRICT x = (const block_vq3_64 *)vx;
+    const block_q8_0 * GGML_RESTRICT y = (const block_q8_0 *)vy;
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VBMI__)
+    GGML_VQ3_64_INIT_CONSTS();
+    __m512 acc0 = _mm512_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        GGML_VQ3_64_UNPACK_STEP(i);
+        GGML_VQ3_64_DOT_COL(y, acc0);
+    }
+    *s = _mm512_reduce_add_ps(acc0);
+#elif defined(__AVX2__)
+    const __m256i shuf_mult = _mm256_setr_epi8(
+        0, -128, 0, -128, 0, -128, 0, -128, 1, -128, 1, -128, 1, -128, 1, -128,
+        2, -128, 2, -128, 2, -128, 2, -128, 3, -128, 3, -128, 3, -128, 3, -128
+    );
+    __m256 acc0 = _mm256_setzero_ps();
+    __m256 acc1 = _mm256_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d) * GGML_VQ3_G;
+        const __m256 vd0 = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2 * i + 0].d));
+        const __m256 vd1 = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2 * i + 1].d));
+
+        const uint32_t lo16 = (uint32_t)_mm_movemask_epi8(_mm_loadu_si128((const __m128i *)x[i].qs));
+        uint32_t hi6 = 0;
+        for (int j = 16; j < 22; ++j) {
+            if (x[i].qs[j] & 0x80U) hi6 |= (1U << j);
+        }
+        const uint32_t s24 = lo16 | hi6 |
+                             (((uint32_t)(x[i].qs[20] >> 6) & 1U) << 22) |
+                             (((uint32_t)(x[i].qs[21] >> 6) & 1U) << 23);
+        const uint64_t m_all = ggml_vq3_unpack_scales(s24);
+        const __m256i vmult01 = _mm256_shuffle_epi8(_mm256_set1_epi32((int32_t)(uint32_t)m_all), shuf_mult);
+        const __m256i vmult23 = _mm256_shuffle_epi8(_mm256_set1_epi32((int32_t)(uint32_t)(m_all >> 32)), shuf_mult);
+
+        int8_t qw[64];
+        for (int j = 0; j < 20; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+            qw[j + 44] = ggml_vq3_cb[c][2];
+        }
+        for (int j = 20; j < 22; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+        }
+
+        const __m256i q01 = _mm256_loadu_si256((const __m256i *)(qw + 0));
+        const __m256i q23 = _mm256_loadu_si256((const __m256i *)(qw + 32));
+        const __m256i q8_0 = _mm256_loadu_si256((const __m256i *)y[2 * i + 0].qs);
+        const __m256i q8_1 = _mm256_loadu_si256((const __m256i *)y[2 * i + 1].qs);
+
+        const __m256i p01 = _mm256_maddubs_epi16(_mm256_abs_epi8(q01), _mm256_sign_epi8(q8_0, q01));
+        const __m256i p23 = _mm256_maddubs_epi16(_mm256_abs_epi8(q23), _mm256_sign_epi8(q8_1, q23));
+
+        const __m256i s01 = _mm256_madd_epi16(p01, vmult01);
+        const __m256i s23 = _mm256_madd_epi16(p23, vmult23);
+
+        acc0 = _mm256_fmadd_ps(vd0, _mm256_cvtepi32_ps(s01), acc0);
+        acc1 = _mm256_fmadd_ps(vd1, _mm256_cvtepi32_ps(s23), acc1);
+    }
+    const __m256 acc = _mm256_add_ps(acc0, acc1);
+    const __m128 res4 = _mm_add_ps(_mm256_castps256_ps128(acc), _mm256_extractf128_ps(acc, 1));
+    const __m128 res2 = _mm_add_ps(res4, _mm_movehl_ps(res4, res4));
+    const __m128 res1 = _mm_add_ss(res2, _mm_movehdup_ps(res2));
+    *s = _mm_cvtss_f32(res1);
+#elif defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    float sumf = 0.0f;
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d) * GGML_VQ3_G;
+        uint32_t s24 = 0;
+        for (int j = 0; j < 22; ++j) {
+            if (x[i].qs[j] & 0x80U) s24 |= (1U << j);
+        }
+        s24 |= (((uint32_t)(x[i].qs[20] >> 6) & 1U) << 22);
+        s24 |= (((uint32_t)(x[i].qs[21] >> 6) & 1U) << 23);
+
+        int8_t qw[64];
+        for (int j = 0; j < 20; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+            qw[j + 44] = ggml_vq3_cb[c][2];
+        }
+        for (int j = 20; j < 22; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+        }
+
+        int32x4_t acc0 = vdupq_n_s32(0);
+        int32x4_t acc1 = vdupq_n_s32(0);
+        for (int g = 0; g < 2; ++g) {
+            const int32x4_t p0 = ggml_vdotq_s32(vdupq_n_s32(0), vld1q_s8(qw + 16*g),      vld1q_s8(y[2*i + 0].qs + 16*g));
+            const int32x4_t p1 = ggml_vdotq_s32(vdupq_n_s32(0), vld1q_s8(qw + 32 + 16*g), vld1q_s8(y[2*i + 1].qs + 16*g));
+            const int32_t m0_lo = (int32_t)(((s24 >> (3*(2*g + 0))) & 0x7U) + 2U);
+            const int32_t m0_hi = (int32_t)(((s24 >> (3*(2*g + 1))) & 0x7U) + 2U);
+            const int32_t m1_lo = (int32_t)(((s24 >> (3*(2*g + 4))) & 0x7U) + 2U);
+            const int32_t m1_hi = (int32_t)(((s24 >> (3*(2*g + 5))) & 0x7U) + 2U);
+            const int32_t mv0[4] = { m0_lo, m0_lo, m0_hi, m0_hi };
+            const int32_t mv1[4] = { m1_lo, m1_lo, m1_hi, m1_hi };
+            acc0 = vmlaq_s32(acc0, p0, vld1q_s32(mv0));
+            acc1 = vmlaq_s32(acc1, p1, vld1q_s32(mv1));
+        }
+        sumf += d0 * (GGML_CPU_FP16_TO_FP32(y[2*i + 0].d) * (float)vaddvq_s32(acc0) +
+                      GGML_CPU_FP16_TO_FP32(y[2*i + 1].d) * (float)vaddvq_s32(acc1));
+    }
+    *s = sumf;
+#else
+    float sumf = 0.0f;
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d) * GGML_VQ3_G;
+        uint32_t s24 = 0;
+        for (int j = 0; j < 22; ++j) {
+            if (x[i].qs[j] & 0x80U) s24 |= (1U << j);
+        }
+        s24 |= (((uint32_t)(x[i].qs[20] >> 6) & 1U) << 22);
+        s24 |= (((uint32_t)(x[i].qs[21] >> 6) & 1U) << 23);
+        int m[8];
+        for (int b = 0; b < 8; ++b) m[b] = (int)(((s24 >> (3 * b)) & 0x7U) + 2U);
+        int8_t qw[64];
+        for (int j = 0; j < 20; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+            qw[j + 44] = ggml_vq3_cb[c][2];
+        }
+        for (int j = 20; j < 22; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+        }
+        int32_t sum0 = 0, sum1 = 0;
+        for (int b = 0; b < 4; ++b) {
+            int32_t sb = 0;
+            for (int j = 0; j < 8; ++j) sb += (int32_t)qw[b * 8 + j] * (int32_t)y[2 * i + 0].qs[b * 8 + j];
+            sum0 += sb * m[b];
+        }
+        for (int b = 4; b < 8; ++b) {
+            int32_t sb = 0;
+            for (int j = 0; j < 8; ++j) sb += (int32_t)qw[b * 8 + j] * (int32_t)y[2 * i + 1].qs[(b - 4) * 8 + j];
+            sum1 += sb * m[b];
+        }
+        sumf += d0 * (GGML_CPU_FP16_TO_FP32(y[2 * i + 0].d) * (float)sum0 +
+                      GGML_CPU_FP16_TO_FP32(y[2 * i + 1].d) * (float)sum1);
+    }
+    *s = sumf;
+#endif
+}
+
+void ggml_vec_dot_vq3_64_q8_0_1x4(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VBMI__)
+    const int nb = n / QK_VQ3_64;
+    const block_vq3_64 * GGML_RESTRICT x = (const block_vq3_64 *)vx;
+    const block_q8_0 * GGML_RESTRICT y0 = (const block_q8_0 *)vy[0];
+    const block_q8_0 * GGML_RESTRICT y1 = (const block_q8_0 *)vy[1];
+    const block_q8_0 * GGML_RESTRICT y2 = (const block_q8_0 *)vy[2];
+    const block_q8_0 * GGML_RESTRICT y3 = (const block_q8_0 *)vy[3];
+    GGML_VQ3_64_INIT_CONSTS();
+    __m512 acc0 = _mm512_setzero_ps(), acc1 = _mm512_setzero_ps(), acc2 = _mm512_setzero_ps(), acc3 = _mm512_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        GGML_VQ3_64_UNPACK_STEP(i);
+        GGML_VQ3_64_DOT_COL(y0, acc0);
+        GGML_VQ3_64_DOT_COL(y1, acc1);
+        GGML_VQ3_64_DOT_COL(y2, acc2);
+        GGML_VQ3_64_DOT_COL(y3, acc3);
+    }
+    s[0] = _mm512_reduce_add_ps(acc0); s[1] = _mm512_reduce_add_ps(acc1);
+    s[2] = _mm512_reduce_add_ps(acc2); s[3] = _mm512_reduce_add_ps(acc3);
+#else
+    for (int k = 0; k < 4; ++k) ggml_vec_dot_vq3_64_q8_0(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
+
+void ggml_vec_dot_vq3_64_q8_0_1x8(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(_WIN32)
+    ggml_vec_dot_vq3_64_q8_0_1x4(n, s, vx, vy);
+    ggml_vec_dot_vq3_64_q8_0_1x4(n, s + 4, vx, vy + 4);
+#elif defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VBMI__)
+    const int nb = n / QK_VQ3_64;
+    const block_vq3_64 * GGML_RESTRICT x = (const block_vq3_64 *)vx;
+    const block_q8_0 * GGML_RESTRICT y0 = (const block_q8_0 *)vy[0];
+    const block_q8_0 * GGML_RESTRICT y1 = (const block_q8_0 *)vy[1];
+    const block_q8_0 * GGML_RESTRICT y2 = (const block_q8_0 *)vy[2];
+    const block_q8_0 * GGML_RESTRICT y3 = (const block_q8_0 *)vy[3];
+    const block_q8_0 * GGML_RESTRICT y4 = (const block_q8_0 *)vy[4];
+    const block_q8_0 * GGML_RESTRICT y5 = (const block_q8_0 *)vy[5];
+    const block_q8_0 * GGML_RESTRICT y6 = (const block_q8_0 *)vy[6];
+    const block_q8_0 * GGML_RESTRICT y7 = (const block_q8_0 *)vy[7];
+    GGML_VQ3_64_INIT_CONSTS();
+    __m512 acc0 = _mm512_setzero_ps(), acc1 = _mm512_setzero_ps(), acc2 = _mm512_setzero_ps(), acc3 = _mm512_setzero_ps();
+    __m512 acc4 = _mm512_setzero_ps(), acc5 = _mm512_setzero_ps(), acc6 = _mm512_setzero_ps(), acc7 = _mm512_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        GGML_VQ3_64_UNPACK_STEP(i);
+        GGML_VQ3_64_DOT_COL(y0, acc0);
+        GGML_VQ3_64_DOT_COL(y1, acc1);
+        GGML_VQ3_64_DOT_COL(y2, acc2);
+        GGML_VQ3_64_DOT_COL(y3, acc3);
+        GGML_VQ3_64_DOT_COL(y4, acc4);
+        GGML_VQ3_64_DOT_COL(y5, acc5);
+        GGML_VQ3_64_DOT_COL(y6, acc6);
+        GGML_VQ3_64_DOT_COL(y7, acc7);
+    }
+    s[0] = _mm512_reduce_add_ps(acc0); s[1] = _mm512_reduce_add_ps(acc1);
+    s[2] = _mm512_reduce_add_ps(acc2); s[3] = _mm512_reduce_add_ps(acc3);
+    s[4] = _mm512_reduce_add_ps(acc4); s[5] = _mm512_reduce_add_ps(acc5);
+    s[6] = _mm512_reduce_add_ps(acc6); s[7] = _mm512_reduce_add_ps(acc7);
+#else
+    for (int k = 0; k < 8; ++k) ggml_vec_dot_vq3_64_q8_0(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
+
+void ggml_vec_dot_vq3_64_q8_0_1x3(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VBMI__)
+    const int nb = n / QK_VQ3_64;
+    const block_vq3_64 * GGML_RESTRICT x = (const block_vq3_64 *)vx;
+    const block_q8_0 * GGML_RESTRICT y0 = (const block_q8_0 *)vy[0];
+    const block_q8_0 * GGML_RESTRICT y1 = (const block_q8_0 *)vy[1];
+    const block_q8_0 * GGML_RESTRICT y2 = (const block_q8_0 *)vy[2];
+    GGML_VQ3_64_INIT_CONSTS();
+    __m512 acc0 = _mm512_setzero_ps(), acc1 = _mm512_setzero_ps(), acc2 = _mm512_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        GGML_VQ3_64_UNPACK_STEP(i);
+        GGML_VQ3_64_DOT_COL(y0, acc0);
+        GGML_VQ3_64_DOT_COL(y1, acc1);
+        GGML_VQ3_64_DOT_COL(y2, acc2);
+    }
+    s[0] = _mm512_reduce_add_ps(acc0); s[1] = _mm512_reduce_add_ps(acc1); s[2] = _mm512_reduce_add_ps(acc2);
+#else
+    for (int k = 0; k < 3; ++k) ggml_vec_dot_vq3_64_q8_0(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
+
+void ggml_vec_dot_vq3_64_q8_0_1x2(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VBMI__)
+    const int nb = n / QK_VQ3_64;
+    const block_vq3_64 * GGML_RESTRICT x = (const block_vq3_64 *)vx;
