+// RouteCrack 2.0 Unified Speculative Engine:
+//   Method 1 (`NextN MTP` Neural Anchor or `RCPredictor` Ensemble) +
+//   Method 2 (`O(1) Indexed Two-Zone Prompt & Context Suffix Copy`) +
+//   Method 3 (`Stockfish-PVS Multi-Order Zobrist TT + 6-Gram Session Memory`) +
+//   Arbiter  (`rc_arbiter_l1.h` RouteCrack 2.0 L1 Micro-Arbiter, `10 -> 16 -> 1` AVX-512 / NEON)
+struct common_speculative_impl_routecrack2 : public common_speculative_impl {
+    common_params_speculative_draft params;
+    std::unique_ptr<common_speculative_impl_draft_mtp> mtp;
+    std::unique_ptr<RC2PredictorHub> rc_hub;
+    std::vector<RC2SeqEngine>       rc2;
+    std::vector<std::vector<float>> mtp_h0;
+    std::vector<float>              seq_e_tok;
+    std::vector<float>              seq_p_surv;
+    std::vector<uint8_t>            seq_want_stem;
+    bool                            is_heavy_moe = false;
+
+    static int32_t resolve_rc2_n_max(const common_params_speculative & spec_params) {
+        const int32_t req = (!spec_params.draft.n_max_explicit && spec_params.draft.n_max == 3)
+            ? RC2SeqEngine::MAX_DRAFT_CAP
+            : spec_params.draft.n_max;
+        return std::min<int32_t>(std::max<int32_t>(0, req), RC2SeqEngine::MAX_DRAFT_CAP);
+    }
+
+    common_speculative_impl_routecrack2(const common_params_speculative & spec_params, uint32_t n_seq)
+        : common_speculative_impl(
+            COMMON_SPECULATIVE_TYPE_ROUTECRACK2,
+            n_seq,
+            resolve_rc2_n_max(spec_params))
+        , params(spec_params.draft)
+    {
+        rc2.resize(n_seq);
+        for (uint32_t i = 0; i < n_seq; ++i) {
+            rc2[i].init();
+        }
+        seq_e_tok.assign(n_seq, 1.0f);
+        seq_p_surv.assign(n_seq, 1.0f);
+        seq_want_stem.assign(n_seq, 0);
+
+        if (this->params.ctx_dft != nullptr && this->params.ctx_tgt != nullptr) {
+            mtp = std::make_unique<common_speculative_impl_draft_mtp>(spec_params, n_seq);
+            this->n_max = resolve_rc2_n_max(spec_params);
+            mtp_h0.assign(n_seq, std::vector<float>(mtp->n_embd, 0.0f));
+            SPC_INF("adding speculative implementation 'routecrack2' (MTP + Two-Zone Suffix + Stockfish-PVS + RouteCrack 2.0 L1 Micro-Arbiter, n_max=%d, sizeof(Arbiter)=%zu B)\n",
+                    this->n_max, sizeof(RC2L1ArbiterWeights));
+        } else {
+            int32_t  n_vocab     = -1;
+            int32_t  n_expert    = -1;
+            uint64_t model_bytes = 0ULL;
+            if (this->params.ctx_tgt != nullptr) {
+                const llama_model * m_tgt = llama_get_model(this->params.ctx_tgt);
+                if (m_tgt != nullptr) {
+                    model_bytes = llama_model_size(m_tgt);
+                    n_expert    = llama_model_n_expert(m_tgt);
+                    const llama_vocab * voc = llama_model_get_vocab(m_tgt);
+                    if (voc != nullptr) {
+                        n_vocab = llama_vocab_n_tokens(voc);
+                    }
+                }
+            }
+            if (n_expert == 0 && this->n_max > 3) {
+                // Dense CPU models execute quantized GEMM in 4-row (mr=4) register tiles;
+                // capping draft length at 3 keeps verification batches (1+3=4) inside a single weight pass.
+                this->n_max = 3;
+            }
+            this->is_heavy_moe = (n_expert > 0 && model_bytes > 35ULL * 1024ULL * 1024ULL * 1024ULL);
+            rc_hub = std::make_unique<RC2PredictorHub>();
+            rc_hub->init(n_vocab);
+            SPC_INF("adding speculative implementation 'routecrack2' (RCPredictor[vocab=%d,offline=%d] + Two-Zone Suffix + Stockfish-PVS + %s, model_gib=%.1f, n_expert=%d, n_max=%d, sizeof(Arbiter)=%zu B)\n",
+                    n_vocab, rc_hub->offline_loaded ? 1 : 0,
+                    this->is_heavy_moe ? "kRC2HeavyMoEDraftlessArbiter" : "kRC2DraftlessArbiter",
+                    (double) model_bytes / (1024.0 * 1024.0 * 1024.0),
+                    n_expert, this->n_max, sizeof(RC2L1ArbiterWeights));
+        }
+    }
+
+    ~common_speculative_impl_routecrack2() override {
+        uint64_t fp = 0, ma = 0, ra = 0, se = 0, sv = 0, sp = 0, nv = 0, st = 0;
+        for (const auto & e : rc2) {
+            fp += e.stat_fastpath_hits;
+            ma += e.stat_mtp_anchors;
+            ra += e.stat_rc_anchors;
+            se += e.stat_suffix_ext_toks;
+            sv += e.stat_sf_vetoes;
+            sp += e.stat_sf_promotions;
+            nv += e.stat_nnue_vetoes;
+            st += e.stat_stem_probes;
+        }
+        if (fp + ma + ra + se > 0) {
+            SPC_INF("routecrack2 telemetry: fastpath=%" PRIu64 ", mtp_anchor=%" PRIu64 ", rc_anchor=%" PRIu64 ", suffix_ext_toks=%" PRIu64
+                    ", sf_veto=%" PRIu64 ", sf_promote=%" PRIu64 ", nnue_veto=%" PRIu64 ", stem_probes=%" PRIu64 "\n",
+                    fp, ma, ra, se, sv, sp, nv, st);
+        }
+    }
+
+    static RC2MTPAnchorInfo extract_mtp_anchor_info(common_sampler * smpl, llama_context * ctx_dft, int batch_idx) {
+        RC2MTPAnchorInfo info;
+        common_sampler_sample(smpl, ctx_dft, batch_idx, true);
+        const auto * cur_p = common_sampler_get_candidates(smpl, true);
+        if (!cur_p || cur_p->size == 0) {
+            return info;
+        }
+        info.n_cands = std::min<int>(4, (int) cur_p->size);
+        float mass4  = 0.0f;
+        for (int k = 0; k < info.n_cands; ++k) {
+            if (!std::isfinite(cur_p->data[k].p)) {
+                return RC2MTPAnchorInfo{};
+            }
+            info.top_ids[k] = cur_p->data[k].id;
+            info.top_p[k]   = cur_p->data[k].p;
+            mass4          += cur_p->data[k].p;
+        }
+        info.p_top1    = cur_p->data[0].p;
+        info.p_margin  = (cur_p->size > 1) ? std::max(0.0f, cur_p->data[0].p - cur_p->data[1].p) : info.p_top1;
+        info.top4_mass = mass4;
+        if (!std::isfinite(info.p_top1) || !std::isfinite(info.p_margin) || !std::isfinite(info.top4_mass)) {
+            return RC2MTPAnchorInfo{};
+        }
+        info.valid = true;
+        return info;
+    }
+
+    void begin(llama_seq_id seq_id, const llama_tokens & prompt) override {
+        if (seq_id >= 0 && seq_id < (llama_seq_id) n_seq) {
+            rc2[seq_id].clear_session_mode();
+        }
+        if (mtp) {
+            mtp->begin(seq_id, prompt);
+        }
+    }
+
+    bool process(const common_batch & batch_in) override {
+        if (mtp) {
+            return mtp->process(batch_in);
+        }
+        return true;
+    }
+
+    void draft(common_speculative_draft_params_vec & dparams) override {
+        std::fill(seq_want_stem.begin(), seq_want_stem.end(), 0);
+
+        if (this->n_max <= 0 || !is_rc2_runtime_enabled()) {
+            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                auto & dp = dparams[seq_id];
+                if (!dp.drafting) continue;
+                dp.result_q = nullptr;
+                dp.result->clear();
+                if (this->n_max > 0) {
+                    rc2[seq_id].sync_context_and_observe(*dp.prompt, dp.id_last);
+                }
+                rc2[seq_id].record_last_draft(*dp.result);
+            }
+            return;
+        }
+
+        // Draftless path when target model has no MTP head (`Nemotron-3.5-30B` & `DeepSeek-V4-284B`)
+        if (!mtp) {
+            const RC2L1ArbiterWeights & dl_weights = this->is_heavy_moe
+                ? kRC2HeavyMoEDraftlessArbiter
+                : kRC2DraftlessArbiter;
+            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                auto & dp = dparams[seq_id];
+                if (!dp.drafting) continue;
+                dp.result_q = nullptr;
+                const int cap = (dp.n_max >= 0) ? std::min<int>(this->n_max, dp.n_max) : this->n_max;
+                rc2[seq_id].sync_context_and_observe(*dp.prompt, dp.id_last);
+                rc2[seq_id].draft_without_mtp(cap, *dp.result, rc_hub.get(), dl_weights, this->is_heavy_moe);
+                if (dp.result->size() < (size_t) params.n_min) {
+                    dp.result->clear();
+                    rc2[seq_id].record_last_draft(*dp.result);
+                }
+            }
+            return;
+        }
+
+        auto * ctx_dft = mtp->params.ctx_dft;
+        mtp->batch.clear();
+
+        // Phase A: Sync O(1) Two-Zone 3-gram index + Stockfish TT, and check Fast-Path Suffix Bypass (< 200 ns)
+        std::vector<uint8_t> need_mtp0(n_seq, 0);
+        for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+            auto & dp = dparams[seq_id];
+            if (!dp.drafting) continue;
+
+            // RouteCrack 2.0 fuses non-neural Suffix/Stockfish tokens with neural MTP;
+            // verify via target greedy/chain sampler without per-token draft_q rejection tables.
+            dp.result_q = nullptr;
+
+            const int cap = (dp.n_max >= 0) ? std::min<int>(this->n_max, dp.n_max) : this->n_max;
+            rc2[seq_id].sync_context_and_observe(*dp.prompt, dp.id_last);
+            if (cap <= 0) {
+                dp.result->clear();
+                rc2[seq_id].record_last_draft(*dp.result);
+                continue;
+            }
+
+            if (rc2[seq_id].try_fastpath_draft(cap, *dp.result, seq_e_tok[seq_id], seq_p_surv[seq_id])) {
+                continue;
+            }
+
+            common_sampler_reset(mtp->smpls[seq_id].get());
+            if (mtp->chain_heads) {
+                llama_memory_seq_rm(llama_get_memory(ctx_dft), seq_id, dp.pos0, -1);
+                llama_set_nextn_layer_offset(ctx_dft, 0);
+            }
+            const int32_t idx = mtp->batch.add(dp.id_last, dp.pos0, seq_id, true);
+            mtp->batch.set_embd_state(idx, { mtp->pending_h[seq_id].data(), 1, (size_t) mtp->n_embd });
+            mtp->i_last[seq_id] = idx;
+            need_mtp0[seq_id]   = 1;
+        }
+
+        // Phase B + C: Run 1 single NextN MTP neural anchor decode (d=0), then anchor Two-Zone Suffix + Stockfish!
+        if (mtp->batch.size() > 0) {
+            const int ret = llama_process(ctx_dft, LLAMA_PROCESS_TYPE_DECODE, mtp->batch.get());
+            if (mtp->chain_heads) {
+                llama_set_nextn_layer_offset(ctx_dft, 0);
+            }
+            if (ret != 0) {
+                SPC_ERR("routecrack2 llama_process[d=0] returned %d\n", ret);
+                return;
+            }
+
+            mtp->batch.clear();
+
+            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                if (!need_mtp0[seq_id]) continue;
+                auto & dp  = dparams[seq_id];
+                const int cap = (dp.n_max >= 0) ? std::min<int>(this->n_max, dp.n_max) : this->n_max;
+
+                auto * smpl = mtp->smpls[seq_id].get();
+                const int b_idx = mtp->i_last[seq_id];
+                const RC2MTPAnchorInfo mtp0 = extract_mtp_anchor_info(smpl, ctx_dft, b_idx);
+                const float * h_row = llama_get_embeddings_nextn_ith(ctx_dft, b_idx);
+
+                bool want_stem = false;
+                rc2[seq_id].fuse_mtp_and_extend(
+                    mtp0, cap, *dp.result, seq_e_tok[seq_id], seq_p_surv[seq_id], want_stem);
+
+                // Phase D Queue: Only when Suffix+Stockfish had 0 continuation AND d=0 MTP confidence is ultra-high!
+                if (want_stem && !mtp->chain_heads && h_row != nullptr && dp.result->size() == 1) {
+                    std::memcpy(mtp_h0[seq_id].data(), h_row, (size_t) mtp->n_embd * sizeof(float));
+                    const llama_token t0 = (*dp.result)[0];
+                    common_sampler_accept(smpl, t0, true);
+                    const llama_pos p1 = mtp->is_mem_shared ? dp.pos0 : (dp.pos0 + 1);
+                    const int32_t idx1 = mtp->batch.add(t0, p1, seq_id, true);
+                    mtp->batch.set_embd_state(idx1, { mtp_h0[seq_id].data(), 1, (size_t) mtp->n_embd });
+                    mtp->i_last[seq_id]   = idx1;
+                    seq_want_stem[seq_id] = 1;
+                }
+            }
+
+            // Phase D Execution: Optional gated neural stem steps (d=1, and d=2 when ultra-certain) + re-anchored Suffix/Stockfish
+            if (mtp->batch.size() > 0) {
+                const int ret1 = llama_process(ctx_dft, LLAMA_PROCESS_TYPE_DECODE, mtp->batch.get());
+                if (ret1 == 0) {
+                    std::vector<uint8_t> seq_want_stem2(n_seq, 0);
+                    for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                        if (!seq_want_stem[seq_id]) continue;
+                        auto & dp = dparams[seq_id];
+                        const int cap = (dp.n_max >= 0) ? std::min<int>(this->n_max, dp.n_max) : this->n_max;
+                        auto * smpl = mtp->smpls[seq_id].get();
+                        const int b_idx1 = mtp->i_last[seq_id];
+                        const RC2MTPAnchorInfo mtp1 = extract_mtp_anchor_info(smpl, ctx_dft, b_idx1);
+                        const float * h_row1 = llama_get_embeddings_nextn_ith(ctx_dft, b_idx1);
+                        bool want_stem2 = false;
+                        rc2[seq_id].finalize_stem_probe(
+                            mtp1, cap, seq_e_tok[seq_id], seq_p_surv[seq_id], *dp.result, &want_stem2);
+                        if (want_stem2 && !mtp->chain_heads && h_row1 != nullptr && dp.result->size() == 2) {
+                            std::memcpy(mtp_h0[seq_id].data(), h_row1, (size_t) mtp->n_embd * sizeof(float));
+                            seq_want_stem2[seq_id] = 1;
+                        }
+                    }
+
+                    mtp->batch.clear();
+                    for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                        if (!seq_want_stem2[seq_id]) continue;
+                        auto & dp = dparams[seq_id];
+                        auto * smpl = mtp->smpls[seq_id].get();
+                        const llama_token t1 = (*dp.result)[1];
+                        common_sampler_accept(smpl, t1, true);
+                        const llama_pos p2 = mtp->is_mem_shared ? dp.pos0 : (dp.pos0 + 2);
+                        const int32_t idx2 = mtp->batch.add(t1, p2, seq_id, true);
+                        mtp->batch.set_embd_state(idx2, { mtp_h0[seq_id].data(), 1, (size_t) mtp->n_embd });
+                        mtp->i_last[seq_id] = idx2;
+                    }
+
+                    if (mtp->batch.size() > 0) {
+                        const int ret2 = llama_process(ctx_dft, LLAMA_PROCESS_TYPE_DECODE, mtp->batch.get());
+                        if (ret2 == 0) {
+                            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                                if (!seq_want_stem2[seq_id]) continue;
+                                auto & dp = dparams[seq_id];
+                                const int cap = (dp.n_max >= 0) ? std::min<int>(this->n_max, dp.n_max) : this->n_max;
+                                auto * smpl = mtp->smpls[seq_id].get();
+                                const RC2MTPAnchorInfo mtp2 = extract_mtp_anchor_info(smpl, ctx_dft, mtp->i_last[seq_id]);
+                                rc2[seq_id].finalize_stem_probe(
+                                    mtp2, cap, seq_e_tok[seq_id], seq_p_surv[seq_id], *dp.result, nullptr);
+                            }
+                        } else {
+                            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                                if (seq_want_stem2[seq_id]) {
+                                    rc2[seq_id].record_last_draft(*dparams[seq_id].result);
+                                }
+                            }
+                        }
+                    }
+                } else {
+                    for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                        if (seq_want_stem[seq_id]) {
+                            rc2[seq_id].record_last_draft(*dparams[seq_id].result);
+                        }
+                    }
+                }
+            }
+        }
+
+        for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+            auto & dp = dparams[seq_id];
+            if (!dp.drafting) continue;
+            if (dp.result->size() < (size_t) params.n_min) {
+                dp.result->clear();
+                rc2[seq_id].record_last_draft(*dp.result);
+            }
+        }
+    }
+
+    void accept(llama_seq_id seq_id, uint16_t n_accepted, bool is_other) override {
+        if (mtp) {
+            mtp->accept(seq_id, n_accepted, is_other);
+        }
+    }
+
+    bool get_state(llama_seq_id seq_id, std::vector<uint8_t> & data) const override {
+        if (mtp) {
+            return mtp->get_state(seq_id, data);
+        }
+        return false;
+    }
+
+    void set_state(llama_seq_id seq_id, const std::vector<uint8_t> & data) override {
+        if (mtp) {
+            mtp->set_state(seq_id, data);
+        }
+    }
+};
