+void ggml_vec_dot_q6_K_q8_K_1x2(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__)
+    const int nb = n / QK_K;
+    const block_q6_K * GGML_RESTRICT x = (const block_q6_K *)vx;
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *)vy[0];
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *)vy[1];
+    const __m256i m3  = _mm256_set1_epi8(3);
+    const __m256i m15 = _mm256_set1_epi8(15);
+    __m256 acc0 = _mm256_setzero_ps();
+    __m256 acc1 = _mm256_setzero_ps();
+
+    for (int i = 0; i < nb; ++i) {
+        const float dx = GGML_CPU_FP16_TO_FP32(x[i].d);
+        const uint8_t * GGML_RESTRICT q4 = x[i].ql;
+        const uint8_t * GGML_RESTRICT qh = x[i].qh;
+        const __m128i scales    = _mm_loadu_si128((const __m128i*)x[i].scales);
+        const __m256i scales_16 = _mm256_cvtepi8_epi16(scales);
+        const __m256i q8sclsub0 = _mm256_slli_epi32(_mm256_madd_epi16(_mm256_loadu_si256((const __m256i*)y0[i].bsums), scales_16), 5);
+        const __m256i q8sclsub1 = _mm256_slli_epi32(_mm256_madd_epi16(_mm256_loadu_si256((const __m256i*)y1[i].bsums), scales_16), 5);
+        __m512i sumi0 = _mm512_setzero_si512();
+        __m512i sumi1 = _mm512_setzero_si512();
+        int is = 0;
+        for (int j = 0; j < QK_K/128; ++j) {
+            const __m256i q4bits1 = _mm256_loadu_si256((const __m256i*)q4); q4 += 32;
+            const __m256i q4bits2 = _mm256_loadu_si256((const __m256i*)q4); q4 += 32;
+            const __m256i q4bitsH = _mm256_loadu_si256((const __m256i*)qh); qh += 32;
+
+            const __m256i q4h_0 = _mm256_slli_epi16(_mm256_and_si256(q4bitsH, m3), 4);
+            const __m256i q4h_1 = _mm256_slli_epi16(_mm256_and_si256(q4bitsH, _mm256_set1_epi8(12)), 2);
+            const __m256i q4h_2 = _mm256_and_si256(q4bitsH, _mm256_set1_epi8(48));
+            const __m256i q4h_3 = _mm256_srli_epi16(_mm256_and_si256(q4bitsH, _mm256_set1_epi8(-64)), 2);
+
+            const __m256i q4_0 = _mm256_or_si256(_mm256_and_si256(q4bits1, m15), q4h_0);
+            const __m256i q4_1 = _mm256_or_si256(_mm256_and_si256(q4bits2, m15), q4h_1);
+            const __m256i q4_2 = _mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(q4bits1, 4), m15), q4h_2);
+            const __m256i q4_3 = _mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(q4bits2, 4), m15), q4h_3);
+
+            const __m256i sc16_0 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 0)));
+            const __m256i sc16_1 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 1)));
+            const __m256i sc16_2 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 2)));
+            const __m256i sc16_3 = _mm256_cvtepi8_epi16(_mm_shuffle_epi8(scales, get_scale_shuffle(is + 3)));
+            is += 4;
+
+            const __m512i q6_01 = _mm512_inserti64x4(_mm512_castsi256_si512(q4_0), q4_1, 1);
+            const __m512i q6_23 = _mm512_inserti64x4(_mm512_castsi256_si512(q4_2), q4_3, 1);
+            const __m512i sc_01 = _mm512_inserti64x4(_mm512_castsi256_si512(sc16_0), sc16_1, 1);
+            const __m512i sc_23 = _mm512_inserti64x4(_mm512_castsi256_si512(sc16_2), sc16_3, 1);
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 128*j +  0));
+                const __m512i q8_23 = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 128*j + 64));
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(sc_01, _mm512_maddubs_epi16(q6_01, q8_01)));
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(sc_23, _mm512_maddubs_epi16(q6_23, q8_23)));
+            }
+            {
+                const __m512i q8_01 = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 128*j +  0));
+                const __m512i q8_23 = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 128*j + 64));
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(sc_01, _mm512_maddubs_epi16(q6_01, q8_01)));
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(sc_23, _mm512_maddubs_epi16(q6_23, q8_23)));
+            }
+        }
+        {
+            const __m256i s256_0 = _mm256_sub_epi32(_mm256_add_epi32(_mm512_castsi512_si256(sumi0), _mm512_extracti64x4_epi64(sumi0, 1)), q8sclsub0);
+            acc0 = _mm256_fmadd_ps(_mm256_set1_ps(y0[i].d * dx), _mm256_cvtepi32_ps(s256_0), acc0);
+        }
+        {
+            const __m256i s256_1 = _mm256_sub_epi32(_mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1)), q8sclsub1);
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(y1[i].d * dx), _mm256_cvtepi32_ps(s256_1), acc1);
+        }
+    }
+    s[0] = hsum_float_8(acc0);
+    s[1] = hsum_float_8(acc1);
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_q6_K_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
+
+// ============================================================================
+// AVX-512 VNNI + BW 512-bit Multi-Column (1x8, 1x4, 1x3, 1x2) Fast Paths
+// for Q1_0, signed-scale Q2_0, Q8_0, and MXFP4 (zero %zmm leak on -avx2)
+// ============================================================================
+
+#if defined(__AVX512VNNI__) && defined(__AVX512BW__)
+static inline void ggml_vec_dot_q1_0_q8_0_1xK_avx512(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy, const int K) {
+    const int nb = n / QK1_0;
+    const block_q1_0 * GGML_RESTRICT x = (const block_q1_0 *) vx;
+    const __m512i zero512 = _mm512_setzero_si512();
+    const __m512i ones512 = _mm512_set1_epi8(1);
+    const bool nt_pf = ggml_cpu_nt_stream_active;
+    __m512 acc[8];
+    for (int k = 0; k < K; ++k) {
+        acc[k] = _mm512_setzero_ps();
+    }
+
+    for (int ib = 0; ib < nb; ++ib) {
+        if (nt_pf && ib + 4 < nb) {
+            _mm_prefetch((const char *) &x[ib + 4], _MM_HINT_NTA);
+        }
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);
+        uint64_t bits01, bits23;
+        memcpy(&bits01, &x[ib].qs[0], sizeof(uint64_t));
+        memcpy(&bits23, &x[ib].qs[8], sizeof(uint64_t));
+        const __m512i u01 = _mm512_maskz_set1_epi8((__mmask64) bits01, 2);
+        const __m512i u23 = _mm512_maskz_set1_epi8((__mmask64) bits23, 2);
+
+        for (int k = 0; k < K; ++k) {
+            const block_q8_0 * GGML_RESTRICT y_ptr = ((const block_q8_0 *) vy[k]) + ib * 4;
+            const __m512i qy01 = _mm512_inserti64x4(
+                    _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) y_ptr[0].qs)),
+                    _mm256_loadu_si256((const __m256i *) y_ptr[1].qs), 1);
+            const __m512i qy23 = _mm512_inserti64x4(
+                    _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) y_ptr[2].qs)),
+                    _mm256_loadu_si256((const __m256i *) y_ptr[3].qs), 1);
+            const __m512i s01 = _mm512_sub_epi32(_mm512_dpbusd_epi32(zero512, u01, qy01), _mm512_dpbusd_epi32(zero512, ones512, qy01));
+            const __m512i s23 = _mm512_sub_epi32(_mm512_dpbusd_epi32(zero512, u23, qy23), _mm512_dpbusd_epi32(zero512, ones512, qy23));
+            const __m512 sc01 = _mm512_insertf32x8(
+                    _mm512_castps256_ps512(_mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y_ptr[0].d))),
+                    _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y_ptr[1].d)), 1);
+            const __m512 sc23 = _mm512_insertf32x8(
+                    _mm512_castps256_ps512(_mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y_ptr[2].d))),
+                    _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y_ptr[3].d)), 1);
+            acc[k] = _mm512_fmadd_ps(sc01, _mm512_cvtepi32_ps(s01), acc[k]);
+            acc[k] = _mm512_fmadd_ps(sc23, _mm512_cvtepi32_ps(s23), acc[k]);
+        }
+    }
+
+    for (int k = 0; k < K; ++k) {
+        s[k] = hsum_float_16(acc[k]);
+    }
+}
+
+static inline void ggml_vec_dot_q2_0_q8_0_1xK_avx512(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy, const int K) {
+    const int nb = n / QK2_0;
+    const block_q2_0 * GGML_RESTRICT x = (const block_q2_0 *) vx;
+    const __m512i zero512 = _mm512_setzero_si512();
+    const __m512i ones512 = _mm512_set1_epi8(1);
+    const bool nt_pf = ggml_cpu_nt_stream_active;
+    __m512 acc[8];
+    for (int k = 0; k < K; ++k) {
+        acc[k] = _mm512_setzero_ps();
+    }
+
+    for (int i = 0; i < nb; ++i) {
+        if (nt_pf && i + 4 < nb) {
+            _mm_prefetch((const char *) &x[i + 4], _MM_HINT_NTA);
+        }
+        const float   dx = GGML_CPU_FP16_TO_FP32(x[i].d);
+        const __m512i v  = q2_0_unpack_64_avx512(x[i].qs);
+        for (int k = 0; k < K; ++k) {
+            const block_q8_0 * GGML_RESTRICT y_ptr = ((const block_q8_0 *) vy[k]) + 2 * i;
+            const __m512i qy = _mm512_inserti64x4(
+                    _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) y_ptr[0].qs)),
+                    _mm256_loadu_si256((const __m256i *) y_ptr[1].qs), 1);
+            const __m512i p  = _mm512_sub_epi32(_mm512_dpbusd_epi32(zero512, v, qy), _mm512_dpbusd_epi32(zero512, ones512, qy));
+            const __m512  sc = _mm512_insertf32x8(
+                    _mm512_castps256_ps512(_mm256_set1_ps(dx * GGML_CPU_FP16_TO_FP32(y_ptr[0].d))),
+                    _mm256_set1_ps(dx * GGML_CPU_FP16_TO_FP32(y_ptr[1].d)), 1);
+            acc[k] = _mm512_fmadd_ps(sc, _mm512_cvtepi32_ps(p), acc[k]);
+        }
+    }
+
+    for (int k = 0; k < K; ++k) {
+        s[k] = hsum_float_16(acc[k]);
+    }
+}
+
+static inline void ggml_vec_dot_q8_0_q8_0_1xK_avx512(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy, const int K) {
+    const int nb = n / QK8_0;
+    const block_q8_0 * GGML_RESTRICT x = (const block_q8_0 *) vx;
+    const __m512i zero512     = _mm512_setzero_si512();
+    const __m512i bias128_512 = _mm512_set1_epi8((char) 0x80);
+    const bool nt_pf = ggml_cpu_nt_stream_active;
+    __m512 acc[8];
+    for (int k = 0; k < K; ++k) {
+        acc[k] = _mm512_setzero_ps();
+    }
+
+    int ib = 0;
+    for (; ib + 1 < nb; ib += 2) {
+        if (nt_pf && ib + 6 < nb) {
+            _mm_prefetch((const char *) &x[ib + 6], _MM_HINT_NTA);
+        }
+        const float dx0 = GGML_CPU_FP16_TO_FP32(x[ib + 0].d);
+        const float dx1 = GGML_CPU_FP16_TO_FP32(x[ib + 1].d);
+        const __m512i qx01 = _mm512_inserti64x4(
+                _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) x[ib + 0].qs)),
+                _mm256_loadu_si256((const __m256i *) x[ib + 1].qs), 1);
+        const __m512i u01  = _mm512_xor_si512(qx01, bias128_512);
+        for (int k = 0; k < K; ++k) {
+            const block_q8_0 * GGML_RESTRICT yk = (const block_q8_0 *) vy[k];
+            const __m512i qy01 = _mm512_inserti64x4(
+                    _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) yk[ib + 0].qs)),
+                    _mm256_loadu_si256((const __m256i *) yk[ib + 1].qs), 1);
+            const __m512i p01  = _mm512_sub_epi32(_mm512_dpbusd_epi32(zero512, u01, qy01), _mm512_dpbusd_epi32(zero512, bias128_512, qy01));
+            const __m512  sc01 = _mm512_insertf32x8(
+                    _mm512_castps256_ps512(_mm256_set1_ps(dx0 * GGML_CPU_FP16_TO_FP32(yk[ib + 0].d))),
+                    _mm256_set1_ps(dx1 * GGML_CPU_FP16_TO_FP32(yk[ib + 1].d)), 1);
+            acc[k] = _mm512_fmadd_ps(sc01, _mm512_cvtepi32_ps(p01), acc[k]);
+        }
+    }
+
+    for (int k = 0; k < K; ++k) {
+        float sumf = hsum_float_16(acc[k]);
+        if (ib < nb) {
+            float tail = 0.0f;
+            const block_q8_0 * yk = (const block_q8_0 *) vy[k];
+            ggml_vec_dot_q8_0_q8_0(QK8_0, &tail, 0, &x[ib], 0, &yk[ib], 0, 1);
+            sumf += tail;
+        }
+        s[k] = sumf;
+    }
+}
+
+static inline void ggml_vec_dot_mxfp4_q8_0_1xK_avx512(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy, const int K) {
+    const int nb = n / QK_MXFP4;
+    const block_mxfp4 * GGML_RESTRICT x = (const block_mxfp4 *) vx;
+    const __m128i lut128  = _mm_add_epi8(_mm_loadu_si128((const __m128i *) kvalues_fp4), _mm_set1_epi8(16));
+    const __m512i lut512  = _mm512_broadcast_i32x4(lut128);
+    const __m512i m4b512  = _mm512_set1_epi8(0x0f);
+    const __m512i zero512 = _mm512_setzero_si512();
+    const __m512i bias512 = _mm512_set1_epi8(16);
+    __m512 acc[8];
+    for (int k = 0; k < K; ++k) {
+        acc[k] = _mm512_setzero_ps();
+    }
+
+    int ib = 0;
+    for (; ib + 1 < nb; ib += 2) {
+        if (ib + 6 < nb) {
+            _mm_prefetch((const char *) &x[ib + 6], _MM_HINT_NTA);
+        }
+        const float dx0 = GGML_CPU_E8M0_TO_FP32_HALF(x[ib + 0].e);
+        const float dx1 = GGML_CPU_E8M0_TO_FP32_HALF(x[ib + 1].e);
+        const __m128i q4_0  = _mm_loadu_si128((const __m128i *) x[ib + 0].qs);
+        const __m128i q4_1  = _mm_loadu_si128((const __m128i *) x[ib + 1].qs);
+        const __m256i nib0  = MM256_SET_M128I(_mm_srli_epi16(q4_0, 4), q4_0);
+        const __m256i nib1  = MM256_SET_M128I(_mm_srli_epi16(q4_1, 4), q4_1);
+        const __m512i nib01 = _mm512_and_si512(_mm512_inserti64x4(_mm512_castsi256_si512(nib0), nib1, 1), m4b512);
+        const __m512i u01   = _mm512_shuffle_epi8(lut512, nib01);
+        for (int k = 0; k < K; ++k) {
+            const block_q8_0 * GGML_RESTRICT yk = (const block_q8_0 *) vy[k];
+            const __m512i qy01 = _mm512_inserti64x4(
+                    _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) yk[ib + 0].qs)),
+                    _mm256_loadu_si256((const __m256i *) yk[ib + 1].qs), 1);
+            const __m512i p01  = _mm512_sub_epi32(_mm512_dpbusd_epi32(zero512, u01, qy01), _mm512_dpbusd_epi32(zero512, bias512, qy01));
+            const __m512  sc01 = _mm512_insertf32x8(
+                    _mm512_castps256_ps512(_mm256_set1_ps(dx0 * GGML_CPU_FP16_TO_FP32(yk[ib + 0].d))),
+                    _mm256_set1_ps(dx1 * GGML_CPU_FP16_TO_FP32(yk[ib + 1].d)), 1);
+            acc[k] = _mm512_fmadd_ps(sc01, _mm512_cvtepi32_ps(p01), acc[k]);
+        }
+    }
+
+    for (int k = 0; k < K; ++k) {
+        float sumf = hsum_float_16(acc[k]);
+        if (ib < nb) {
+            float tail = 0.0f;
+            const block_q8_0 * yk = (const block_q8_0 *) vy[k];
+            ggml_vec_dot_mxfp4_q8_0(QK_MXFP4, &tail, 0, &x[ib], 0, &yk[ib], 0, 1);
+            sumf += tail;
+        }
+        s[k] = sumf;
+    }
+}
+#endif
