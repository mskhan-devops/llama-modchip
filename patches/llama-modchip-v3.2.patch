+struct rc2_modchip_shm_t {
+    uint32_t magic;            // 0x4D4F4443 ("MODC")
+    uint32_t version;          // 1
+    int32_t  l3_window;
+    int32_t  attn_window;
+    int32_t  attn_sinks;
