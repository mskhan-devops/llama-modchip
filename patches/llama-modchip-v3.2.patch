+};
+
+static const rc2_modchip_shm_t * get_rc2_modchip_shm() {
+#if defined(__linux__)
+    static std::atomic<const rc2_modchip_shm_t *> shm_ptr{ nullptr };
+    static std::atomic<uint32_t> probe_tick{ 0 };
