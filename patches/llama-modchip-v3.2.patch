+#define DEFINE_VEC_DOT_1XK_WRAPPER(NAME, SINGLE_FN, AVX512_FN) \
+void NAME##_1x8(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) { \
+    AVX512_FN(n, s, vx, vy, 8, SINGLE_FN) \
+} \
+void NAME##_1x4(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) { \
+    AVX512_FN(n, s, vx, vy, 4, SINGLE_FN) \
+} \
+void NAME##_1x3(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) { \
+    AVX512_FN(n, s, vx, vy, 3, SINGLE_FN) \
+} \
+void NAME##_1x2(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) { \
+    AVX512_FN(n, s, vx, vy, 2, SINGLE_FN) \
+}
+
+#if defined(__AVX512VNNI__) && defined(__AVX512BW__)
+#define DISPATCH_1XK_Q1_0(n, s, vx, vy, K, FN)  ggml_vec_dot_q1_0_q8_0_1xK_avx512(n, s, vx, vy, K);
+#define DISPATCH_1XK_Q2_0(n, s, vx, vy, K, FN)  ggml_vec_dot_q2_0_q8_0_1xK_avx512(n, s, vx, vy, K);
+#define DISPATCH_1XK_Q8_0(n, s, vx, vy, K, FN)  ggml_vec_dot_q8_0_q8_0_1xK_avx512(n, s, vx, vy, K);
+#define DISPATCH_1XK_MXFP4(n, s, vx, vy, K, FN) ggml_vec_dot_mxfp4_q8_0_1xK_avx512(n, s, vx, vy, K);
+#else
+#define DISPATCH_1XK_Q1_0(n, s, vx, vy, K, FN)  for (int k = 0; k < (K); ++k) FN(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#define DISPATCH_1XK_Q2_0(n, s, vx, vy, K, FN)  for (int k = 0; k < (K); ++k) FN(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#define DISPATCH_1XK_Q8_0(n, s, vx, vy, K, FN)  for (int k = 0; k < (K); ++k) FN(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#define DISPATCH_1XK_MXFP4(n, s, vx, vy, K, FN) for (int k = 0; k < (K); ++k) FN(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+
+DEFINE_VEC_DOT_1XK_WRAPPER(ggml_vec_dot_q1_0_q8_0,  ggml_vec_dot_q1_0_q8_0,  DISPATCH_1XK_Q1_0)
+DEFINE_VEC_DOT_1XK_WRAPPER(ggml_vec_dot_q2_0_q8_0,  ggml_vec_dot_q2_0_q8_0,  DISPATCH_1XK_Q2_0)
+DEFINE_VEC_DOT_1XK_WRAPPER(ggml_vec_dot_q8_0_q8_0,  ggml_vec_dot_q8_0_q8_0,  DISPATCH_1XK_Q8_0)
+DEFINE_VEC_DOT_1XK_WRAPPER(ggml_vec_dot_mxfp4_q8_0, ggml_vec_dot_mxfp4_q8_0, DISPATCH_1XK_MXFP4)
+
+#undef DISPATCH_1XK_Q1_0
+#undef DISPATCH_1XK_Q2_0
+#undef DISPATCH_1XK_Q8_0
+#undef DISPATCH_1XK_MXFP4
+#undef DEFINE_VEC_DOT_1XK_WRAPPER
