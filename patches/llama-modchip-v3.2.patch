+
+// ============================ FRACTAL_64 (3.75 bpw, 30 B / 64 weights) & VQ3_64 (3.00 bpw, 24 B / 64 weights)
+
+static inline uint8_t ggml_fractal3_quant_scalar(float u) {
+    // Non-linear dyadic codebook: {-14, -8, -4, -1, 1, 4, 8, 14}
+    // Midpoints: {-11.0, -6.0, -2.5, 0.0, 2.5, 6.0, 11.0}
+    if (u < 0.0f) {
+        if (u < -6.0f) return (u < -11.0f) ? 0 : 1;
+        return (u < -2.5f) ? 2 : 3;
+    } else {
+        if (u < 6.0f) return (u < 2.5f) ? 4 : 5;
+        return (u < 11.0f) ? 6 : 7;
+    }
+}
+
+void quantize_row_fractal_64_ref(const float * GGML_RESTRICT x, block_fractal_64 * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QK_FRACTAL_64;
+    static const int8_t kvalues_fractal3[8] = { -14, -8, -4, -1, 1, 4, 8, 14 };
+
+    assert(k % qk == 0);
+
+    const int64_t nb = k / qk;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float * xb = x + i * qk;
+        float s_opt[8];
+        float max_s = 0.0f;
+
+        for (int b = 0; b < 8; ++b) {
+            const float * xsb = xb + b * 8;
+            float amax = 0.0f;
+            for (int m = 0; m < 8; ++m) {
+                const float a = fabsf(xsb[m]);
+                if (a > amax) amax = a;
+            }
+            float sb = amax / 14.0f;
+            if (sb > 0.0f) {
+                for (int it = 0; it < 2; ++it) {
+                    const float isb = 1.0f / sb;
+                    float wx = 0.0f;
+                    float qq = 0.0f;
+                    for (int m = 0; m < 8; ++m) {
+                        const uint8_t idx = ggml_fractal3_quant_scalar(xsb[m] * isb);
+                        const float qv = (float)kvalues_fractal3[idx];
+                        wx += xsb[m] * qv;
+                        qq += qv * qv;
+                    }
+                    if (qq > 0.0f && wx > 0.0f) {
+                        sb = wx / qq;
+                    }
+                }
+            }
+            s_opt[b] = sb;
+            if (sb > max_s) max_s = sb;
+        }
+
+        const float d_fp32 = max_s / 19.0f;
+        y[i].d = GGML_FP32_TO_FP16(d_fp32);
+        const float d = GGML_FP16_TO_FP32(y[i].d);
+
+        memset(y[i].scales, 0, sizeof(y[i].scales));
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+        memset(y[i].qh, 0, sizeof(y[i].qh));
+
+        if (d <= 0.0f) {
+            continue;
+        }
+
+        uint8_t idx_block[64];
+        uint8_t sc_block[8];
+
+        for (int b = 0; b < 8; ++b) {
+            const float * xsb = xb + b * 8;
+            int sc_est = (int)roundf(s_opt[b] / d) - 4;
+            if (sc_est < 0) sc_est = 0;
+            if (sc_est > 15) sc_est = 15;
+
+            int sc_lo = sc_est - 2;
+            int sc_hi = sc_est + 2;
+            if (sc_lo < 0) sc_lo = 0;
+            if (sc_hi > 15) sc_hi = 15;
+
+            float best_err = FLT_MAX;
+            uint8_t best_sc = (uint8_t)sc_est;
+            uint8_t best_idx[8] = {4, 4, 4, 4, 4, 4, 4, 4};
+
+            for (int sc = sc_lo; sc <= sc_hi; ++sc) {
+                const float eff_s = d * (float)(4 + sc);
+                const float ieff_s = 1.0f / eff_s;
+                float err = 0.0f;
+                uint8_t cur_idx[8];
+                for (int m = 0; m < 8; ++m) {
+                    const uint8_t idx = ggml_fractal3_quant_scalar(xsb[m] * ieff_s);
+                    cur_idx[m] = idx;
+                    const float diff = xsb[m] - eff_s * (float)kvalues_fractal3[idx];
+                    err += diff * diff;
+                }
+                if (err < best_err) {
+                    best_err = err;
+                    best_sc = (uint8_t)sc;
+                    for (int m = 0; m < 8; ++m) best_idx[m] = cur_idx[m];
+                }
+            }
+
+            sc_block[b] = best_sc;
+            for (int m = 0; m < 8; ++m) {
+                idx_block[b * 8 + m] = best_idx[m];
+            }
+        }
+
+        for (int b = 0; b < 4; ++b) {
+            y[i].scales[b] = (uint8_t)((sc_block[b] & 0x0F) | ((sc_block[b + 4] & 0x0F) << 4));
+        }
+
+        for (int g = 0; g < 4; ++g) {
+            for (int k_idx = 0; k_idx < 16; ++k_idx) {
+                const uint8_t idx = idx_block[g * 16 + k_idx];
+                y[i].qs[k_idx] |= (uint8_t)((idx & 0x03) << (2 * g));
+                y[i].qh[k_idx & 7] |= (uint8_t)(((idx >> 2) & 0x01) << (2 * g + (k_idx >> 3)));
+            }
+        }
+    }
+}
+
+void dequantize_row_fractal_64(const block_fractal_64 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QK_FRACTAL_64;
+    static const int8_t kvalues_fractal3[8] = { -14, -8, -4, -1, 1, 4, 8, 14 };
+
+    assert(k % qk == 0);
+
+    const int64_t nb = k / qk;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+        float eff_s[8];
+        for (int b = 0; b < 4; ++b) {
+            eff_s[b]     = d * (float)(4 + (x[i].scales[b] & 0x0F));
+            eff_s[b + 4] = d * (float)(4 + ((x[i].scales[b] >> 4) & 0x0F));
+        }
+
+        for (int g = 0; g < 4; ++g) {
+            for (int k_idx = 0; k_idx < 16; ++k_idx) {
+                const int j = g * 16 + k_idx;
+                const uint8_t lo2 = (x[i].qs[k_idx] >> (2 * g)) & 0x03;
+                const uint8_t hi1 = (x[i].qh[k_idx & 7] >> (2 * g + (k_idx >> 3))) & 0x01;
+                const uint8_t idx = (uint8_t)(lo2 | (hi1 << 2));
+                y[i * qk + j] = eff_s[j >> 3] * (float)kvalues_fractal3[idx];
+            }
+        }
+    }
+}
+
+size_t quantize_fractal_64(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    GGML_UNUSED(quant_weights);
+    quantize_row_fractal_64_ref(src, dst, (int64_t)nrow * n_per_row);
+    return nrow * ggml_row_size(GGML_TYPE_FRACTAL_64, n_per_row);
+}
+
+void quantize_row_vq3_64_ref(const float * GGML_RESTRICT x, block_vq3_64 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_VQ3_64 == 0);
+    const int64_t nb = k / QK_VQ3_64;
+    float cb_q[128][3];
+    float cb_c2[128][3];
+    for (int c = 0; c < 128; ++c) {
+        for (int j = 0; j < 3; ++j) {
+            const float v = (float)ggml_vq3_cb[c][j] * GGML_VQ3_G;
+            cb_q[c][j] = v;
+            cb_c2[c][j] = v * v;
+        }
+    }
+
+    for (int64_t b = 0; b < nb; ++b) {
+        const float * xb = x + b * 64;
+        float sub_amax[8];
+        float blk_amax = 0.0f;
+        for (int s = 0; s < 8; ++s) {
+            float amax = 0.0f;
+            for (int j = 0; j < 8; ++j) {
+                const float av = fabsf(xb[s * 8 + j]);
+                if (av > amax) amax = av;
+            }
+            sub_amax[s] = amax * 0.88f;
+            if (sub_amax[s] > blk_amax) blk_amax = sub_amax[s];
+        }
+
+        const ggml_half d_h = (blk_amax > 0.0f) ? GGML_FP32_TO_FP16(blk_amax / 9.0f) : 0;
+        const float d = GGML_FP16_TO_FP32(d_h);
+        if (d <= 1e-30f) {
+            y[b].d = 0;
+            memset(y[b].qs, 0, 22);
+            continue;
+        }
+
+        float m[8];
+        for (int s = 0; s < 8; ++s) {
+            float mr = roundf(sub_amax[s] / d);
+            if (mr < 2.0f) mr = 2.0f;
+            if (mr > 9.0f) mr = 9.0f;
+            m[s] = mr;
+        }
+
+        uint8_t idx22[22];
+        float w_rec[64];
+
+        for (int iter = 0; iter < 3; ++iter) {
+            float eff_s[64];
+            for (int s = 0; s < 8; ++s) {
+                const float es = d * m[s];
+                for (int j = 0; j < 8; ++j) eff_s[s * 8 + j] = es;
+            }
+
+            for (int j = 0; j < 20; ++j) {
+                const float w0 = xb[j],      s0 = eff_s[j],      s02 = s0 * s0, ws0 = w0 * s0;
+                const float w1 = xb[j + 22], s1 = eff_s[j + 22], s12 = s1 * s1, ws1 = w1 * s1;
+                const float w2 = xb[j + 44], s2 = eff_s[j + 44], s22 = s2 * s2, ws2 = w2 * s2;
+                float best_d = 1e30f;
+                int best_c = 0;
+                for (int c = 0; c < 128; ++c) {
+                    const float dist = (s02 * cb_c2[c][0] + s12 * cb_c2[c][1] + s22 * cb_c2[c][2])
+                                     - 2.0f * (ws0 * cb_q[c][0] + ws1 * cb_q[c][1] + ws2 * cb_q[c][2]);
+                    if (dist < best_d) { best_d = dist; best_c = c; }
+                }
+                idx22[j] = (uint8_t)best_c;
+                w_rec[j]      = cb_q[best_c][0];
+                w_rec[j + 22] = cb_q[best_c][1];
+                w_rec[j + 44] = cb_q[best_c][2];
+            }
+
+            const int s7_u3 = ((int)roundf(m[7] - 2.0f)) & 0x7;
+            for (int u = 0; u < 2; ++u) {
+                const int j = 20 + u;
+                const int bit_half = (s7_u3 >> (u + 1)) & 1;
+                const int c_start = bit_half ? 64 : 0;
+                const int c_end   = bit_half ? 128 : 64;
