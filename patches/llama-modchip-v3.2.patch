+    for (int i = 0; i < nb; ++i) {
+        GGML_VQ3_64_UNPACK_STEP(i);
+        GGML_VQ3_64_DOT_COL(y0, acc0);
+        GGML_VQ3_64_DOT_COL(y1, acc1);
+    }
+    s[0] = _mm512_reduce_add_ps(acc0); s[1] = _mm512_reduce_add_ps(acc1);
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_vq3_64_q8_0(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
