+void ggml_vec_dot_iq2_xxs_q8_K_1x2(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * const * GGML_RESTRICT vy) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__) && defined(__BMI2__)
+    const int nb = n / QK_K;
+    const block_iq2_xxs * GGML_RESTRICT x = (const block_iq2_xxs *)vx;
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *)vy[0];
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *)vy[1];
+    __m256 acc0 = _mm256_setzero_ps();
+    __m256 acc1 = _mm256_setzero_ps();
+    const __m512i zero512 = _mm512_setzero_si512();
+    uint32_t aux32[4];
+    const uint8_t * aux8 = (const uint8_t *)aux32;
+
+    for (int i = 0; i < nb; ++i) {
+        const float dx = GGML_CPU_FP16_TO_FP32(x[i].d);
+        const uint16_t * GGML_RESTRICT q2 = x[i].qs;
+        __m512i sumi0 = _mm512_setzero_si512();
+        __m512i sumi1 = _mm512_setzero_si512();
+        for (int ib32 = 0; ib32 < QK_K/32; ib32 += 2) {
+            memcpy(aux32, q2, 4*sizeof(uint32_t)); q2 += 8;
+            const __m256i q2_1 = _mm256_set_epi64x(iq2xxs_grid[aux8[3]], iq2xxs_grid[aux8[2]], iq2xxs_grid[aux8[1]], iq2xxs_grid[aux8[0]]);
+            const __m256i q2_2 = _mm256_set_epi64x(iq2xxs_grid[aux8[11]], iq2xxs_grid[aux8[10]], iq2xxs_grid[aux8[9]], iq2xxs_grid[aux8[8]]);
+            const __m512i q2_512 = _mm512_inserti64x4(_mm512_castsi256_si512(q2_1), q2_2, 1);
+
+            const uint64_t s56 = ((uint64_t)(aux32[1] & 0x0fffffffu)) | (((uint64_t)(aux32[3] & 0x0fffffffu)) << 28);
+            uint64_t m64 = _pdep_u64(s56, 0x7f7f7f7f7f7f7f7fULL);
+            uint64_t p = m64 ^ (m64 >> 4);
+            p ^= (p >> 2);
+            p ^= (p >> 1);
+            m64 |= (p & 0x0101010101010101ULL) << 7;
+            const __mmask64 neg_m = (__mmask64)m64;
+
+            const uint16_t ls1 = 2*(aux32[1] >> 28) + 1;
+            const uint16_t ls2 = 2*(aux32[3] >> 28) + 1;
+            const __m512i v_ls = _mm512_inserti64x4(_mm512_castsi256_si512(_mm256_set1_epi16(ls1)), _mm256_set1_epi16(ls2), 1);
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y0[i].qs + 32*ib32));
+                const __m512i q8_s   = _mm512_mask_sub_epi8(q8_all, neg_m, zero512, q8_all);
+                sumi0 = _mm512_add_epi32(sumi0, _mm512_madd_epi16(_mm512_maddubs_epi16(q2_512, q8_s), v_ls));
+            }
+            {
+                const __m512i q8_all = _mm512_loadu_si512((const __m512i *)(y1[i].qs + 32*ib32));
+                const __m512i q8_s   = _mm512_mask_sub_epi8(q8_all, neg_m, zero512, q8_all);
+                sumi1 = _mm512_add_epi32(sumi1, _mm512_madd_epi16(_mm512_maddubs_epi16(q2_512, q8_s), v_ls));
+            }
+        }
+        {
+            const __m256i s256_0 = _mm256_add_epi32(_mm512_castsi512_si256(sumi0), _mm512_extracti64x4_epi64(sumi0, 1));
+            acc0 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y0[i].d), _mm256_cvtepi32_ps(s256_0), acc0);
+        }
+        {
+            const __m256i s256_1 = _mm256_add_epi32(_mm512_castsi512_si256(sumi1), _mm512_extracti64x4_epi64(sumi1, 1));
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(dx * y1[i].d), _mm256_cvtepi32_ps(s256_1), acc1);
+        }
+    }
+    s[0] = 0.125f * hsum_float_8(acc0);
+    s[1] = 0.125f * hsum_float_8(acc1);
+#else
+    for (int k = 0; k < 2; ++k) ggml_vec_dot_iq2_xxs_q8_K(n, &s[k], 0, vx, 0, vy[k], 0, 1);
+#endif
+}
