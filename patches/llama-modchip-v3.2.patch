+                            long warm_n = std::min<long>(n_toks, 80000);
+                            if (std::fseek(f, (n_toks - warm_n) * 4, SEEK_SET) == 0) {
+                                std::vector<int32_t> buf((size_t)warm_n);
+                                if (std::fread(buf.data(), 4, (size_t)warm_n, f) == (size_t)warm_n) {
+                                    for (long j = 12; j < warm_n; ++j) {
