+    lut2[tiisg + 32] = float2(fractal_64_cb((tiisg + 32) & 7), fractal_64_cb((tiisg + 32) >> 3));
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const short ix = (tiisg/4);
+    const short it = (tiisg%4);
+
+    device const float * yb = y + ix*QK_FRACTAL_64 + 4*it;
+
+    for (int ib = ix; ib < nb; ib += N_SIMDWIDTH/4) {
+        FOR_UNROLL (short g = 0; g < 4; g++) {
+            y4[g] = float4(*(device const packed_float4 *)(yb + 16*g));
+        }
+
+        FOR_UNROLL (short row = 0; row < nr0; row++) {
