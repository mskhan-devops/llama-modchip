+static inline float ggml_swiglu_gate_mask_128(
+        const float * gate_col,
+        int64_t ir0_start,
+        int64_t ir0_end,
+        int keep_128,
+        uint8_t * keep_mask) {
+    const int n = (int)(ir0_end - ir0_start);
+    const int k_keep = (keep_128 * n) >> 7;
+    if (n <= 0 || n > 128 || k_keep <= 0 || k_keep >= n) {
+        if (n > 0 && n <= 128) memset(keep_mask, 1, n);
+        return 1.0f;
+    }
+    float s2[128];
+    float sorted_s2[128];
+    float orig_l2 = 0.0f;
+    const float * g = gate_col + ir0_start;
+    for (int i = 0; i < n; ++i) {
+        const float x = g[i];
+        const float silu = x / (1.0f + expf(-x));
+        const float v2 = silu * silu;
+        s2[i] = v2;
+        sorted_s2[i] = v2;
+        orig_l2 += v2;
+    }
+    const int target = n - k_keep;
+    int left = 0, right = n - 1;
+    while (left < right) {
+        const float pivot = sorted_s2[(left + right) >> 1];
+        int i = left, j = right;
+        while (i <= j) {
+            while (sorted_s2[i] < pivot) i++;
+            while (sorted_s2[j] > pivot) j--;
+            if (i <= j) {
+                const float t = sorted_s2[i];
+                sorted_s2[i] = sorted_s2[j];
+                sorted_s2[j] = t;
+                i++;
+                j--;
+            }
+        }
+        if (target <= j) right = j;
+        else if (target >= i) left = i;
+        else break;
+    }
+    const float thresh = sorted_s2[target];
+    float kept_l2 = 0.0f;
+    int kept_cnt = 0;
+    for (int i = 0; i < n; ++i) {
+        if (s2[i] > thresh) {
+            keep_mask[i] = 1;
+            kept_l2 += s2[i];
+            kept_cnt++;
+        } else {
+            keep_mask[i] = 0;
+        }
+    }
+    for (int i = 0; i < n && kept_cnt < k_keep; ++i) {
+        if (!keep_mask[i] && s2[i] >= thresh) {
+            keep_mask[i] = 1;
+            kept_l2 += s2[i];
+            kept_cnt++;
+        }
+    }
+    if (kept_l2 > 1e-20f && kept_l2 < orig_l2) {
+        return sqrtf(orig_l2 / kept_l2);
+    }
+    return 1.0f;
+}
