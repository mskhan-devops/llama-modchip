+        const float ppm_dom = (n_ppm >= 2 && ppm_scores[0] > 0.0f)
+            ? (ppm_scores[0] / (ppm_scores[0] + ppm_scores[1]))
+            : (n_ppm == 1 ? 1.0f : 0.0f);
