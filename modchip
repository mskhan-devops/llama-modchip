cmd_download_bin() {
    local dest_dir="${WORKSPACE_DIR}/bin"
    local all_tools="${MODCHIP_ALL_TOOLS:-0}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all-tools|--all)
                all_tools=1
                shift
                ;;
            -h|--help)
                echo "Usage: ./modchip download-bin [--all-tools] [dest_dir]"
                echo "  --all-tools   Also download llama-bench, llama-perplexity, and llama-quantize"
                echo "                (equivalent to MODCHIP_ALL_TOOLS=1)"
                return 0
                ;;
            -*)
                echo -e "${YELLOW}[!] Unknown option for download-bin: $1${RESET}" >&2
                exit 1
                ;;
            *)
                dest_dir="$1"
                shift
                ;;
        esac
    done
    mkdir -p "$dest_dir"
    if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
        echo -e "${YELLOW}[!] Prebuilt Linux x86_64 binaries do not match $(uname -s)/$(uname -m); run './modchip setup' to build natively.${RESET}"
        exit 1
    fi
    local flags=""
    [[ -r /proc/cpuinfo ]] && flags="$(grep -m1 -E '^flags' /proc/cpuinfo || true)"
    local isa_suffix="avx2"
    local srv_sha256="d96745036cb44f76bce70237fc1e474058958e4d2eff739b85415eac4c78131d"
    local cli_sha256="08c6236eec64d645b0528d1752f8423bfa028753c8f974c46b6556b1a9022709"
    local bnc_sha256="5d6f9c7a8fd63d3ba6243f3c96b64fe7ae1fd762d814e8b509b9589465a7cff6"
    local ppl_sha256="edae007a49e88e14d2d9a79f0d07fb2b32ee003c6016f55610806bf2ddbdfcc0"
    local qnt_sha256="d8a00d6853b9c345a48c66ffa8948ac52d08b48db65c949831bfd2e890d49424"
    if echo "$flags" | grep -q "avx512f" && echo "$flags" | grep -qE "avx512_?vbmi" && echo "$flags" | grep -qE "avx512_?vnni"; then
        isa_suffix="avx512"
        srv_sha256="0cf2d3bcd31349d98bcef1d23af3545912b70930049437e8aa7f6cf5e2ff2082"
        cli_sha256="dc4c9da5016a8bf4407e14691407b0471625bb775cf76ad2a71e7bc25e0a98af"
        bnc_sha256="9e40525f859214dc36aab36cb99bc81b68762816e1dbe07b31dc8d92b2a037e6"
        ppl_sha256="b52c9b537ec9dc6f635b2d45e20b6d6b48123eacb7218584be5e1056a51e5913"
        qnt_sha256="f24985fa7f595aded7bc9cb523bbf4153362126e80f7bf161b339d5c07352cbe"
    elif ! echo "$flags" | grep -q "avx2"; then
        echo -e "${YELLOW}[!] CPU lacks AVX2; run './modchip setup --source' to compile scalar/AVX1 fallback from source.${RESET}"
        exit 1
    fi
    local srv_asset="llama-server-modchip-linux-x86_64-${isa_suffix}"
    local cli_asset="llama-cli-modchip-linux-x86_64-${isa_suffix}"
    local base_url="https://github.com/synchopate/llama-modchip/releases/download/v3.2.0"
    local fallback_url="https://huggingface.co/Synchopate/Qwen3.8-Flash-Next-MaxQ-64GB-GGUF/resolve/main"
    local tools_msg="${srv_asset} & ${cli_asset}"
    [[ "$all_tools" == "1" ]] && tools_msg="${srv_asset}, ${cli_asset}, llama-bench, llama-perplexity & llama-quantize"
    echo -e "${CYAN}[*] CPUID detected '${isa_suffix}' ISA — downloading portable v3.2.0 ${tools_msg} (static libgomp/libstdc++, GLIBC <= 2.30)...${RESET}"
    curl -fL --progress-bar -o "${dest_dir}/${srv_asset}.part" "${base_url}/${srv_asset}" \
        || curl -fL --progress-bar -o "${dest_dir}/${srv_asset}.part" "${fallback_url}/${srv_asset}"
    local actual_srv_sha
    actual_srv_sha="$(compute_sha256 "${dest_dir}/${srv_asset}.part")"
    if [[ "$actual_srv_sha" != "$srv_sha256" ]]; then
        echo -e "${YELLOW}[!] SHA-256 mismatch on ${srv_asset} (expected ${srv_sha256}, got ${actual_srv_sha})!${RESET}" >&2
        rm -f "${dest_dir}/${srv_asset}.part"
        exit 1
    fi
    chmod +x "${dest_dir}/${srv_asset}.part"
    if ! "${dest_dir}/${srv_asset}.part" --version >/dev/null 2>&1; then
        echo -e "${YELLOW}[!] Downloaded ${srv_asset} failed --version check on this host; run './modchip setup --source' to compile natively.${RESET}" >&2
        rm -f "${dest_dir}/${srv_asset}.part"
        exit 1
    fi
    mv -f "${dest_dir}/${srv_asset}.part" "${dest_dir}/${srv_asset}"
    ln -sf "${srv_asset}" "${dest_dir}/llama-server-modchip-linux-x86_64"
    cp -f "${dest_dir}/${srv_asset}" "${WORKSPACE_DIR}/bin/llama-server-nemotron" 2>/dev/null || true

    local pair
    for pair in \
        "${cli_asset}:${cli_sha256}:llama-cli-modchip-linux-x86_64:llama-cli" \
        "llama-bench-modchip-linux-x86_64-${isa_suffix}:${bnc_sha256}:llama-bench:llama-bench-modchip-linux-x86_64" \
        "llama-perplexity-modchip-linux-x86_64-${isa_suffix}:${ppl_sha256}:llama-perplexity:llama-perplexity-modchip-linux-x86_64" \
        "llama-quantize-modchip-linux-x86_64-${isa_suffix}:${qnt_sha256}:llama-quantize:llama-quantize-modchip-linux-x86_64"; do
        local asset_name="${pair%%:*}"
        local rest="${pair#*:}"
        local exp_sha="${rest%%:*}"
        rest="${rest#*:}"
        local link_name="${rest%%:*}"
        local alt_link="${rest#*:}"
        if [[ "$link_name" != "llama-cli-modchip-linux-x86_64" && "$all_tools" != "1" ]]; then
            continue
        fi
        if curl -fL --progress-bar -o "${dest_dir}/${asset_name}.part" "${base_url}/${asset_name}" \
            || curl -fL --progress-bar -o "${dest_dir}/${asset_name}.part" "${fallback_url}/${asset_name}"; then
            local got_sha
            got_sha="$(compute_sha256 "${dest_dir}/${asset_name}.part")"
            if [[ "$got_sha" == "$exp_sha" ]]; then
                chmod +x "${dest_dir}/${asset_name}.part"
                mv -f "${dest_dir}/${asset_name}.part" "${dest_dir}/${asset_name}"
                ln -sf "${asset_name}" "${dest_dir}/${link_name}"
                [[ -n "$alt_link" ]] && ln -sf "${asset_name}" "${dest_dir}/${alt_link}"
            else
                echo -e "${YELLOW}[!] SHA-256 mismatch on ${asset_name} (expected ${exp_sha}, got ${got_sha}); removed.${RESET}" >&2
                rm -f "${dest_dir}/${asset_name}.part"
                exit 1
            fi
        else
            echo -e "${YELLOW}[!] Failed to download ${asset_name} from both GitHub Release and Hugging Face mirror.${RESET}" >&2
            rm -f "${dest_dir}/${asset_name}.part"
            exit 1
        fi
    done
    echo -e "${GREEN}[✓] Installed & verified ${dest_dir}/${srv_asset} (v3.2.0 SHA-256 + --version OK)${RESET}"
    if [[ "$all_tools" == "1" ]]; then
        echo -e "${GREEN}[✓] Companion tools ready in ${dest_dir}: llama-cli, llama-bench, llama-perplexity, llama-quantize${RESET}"
    else
        echo -e "${CYAN}[i] Tip: Pass '--all-tools' to also install llama-bench, llama-perplexity, and llama-quantize.${RESET}"
    fi
}

