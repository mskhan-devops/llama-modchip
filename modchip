cmd_stop() {
    local stopped=0
    local pids_to_wait=()
    for pf in "$GATEWAY_PID_FILE" "$SERVER_PID_FILE"; do
        if [[ -f "$pf" ]]; then
            local pid
            pid="$(cat "$pf" 2>/dev/null || true)"
            if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null || true
                pids_to_wait+=("$pid")
                stopped=1
            fi
            rm -f "$pf"
        fi
    done
    rm -f "$GATEWAY_HOST_FILE"
    local esc_repo
    esc_repo="$(printf '%s' "$REPO_ROOT" | sed 's/[][\.*^$+?(){}|]/\\&/g')"
    local esc_ws
    esc_ws="$(printf '%s' "$WORKSPACE_DIR" | sed 's/[][\.*^$+?(){}|]/\\&/g')"
    pkill -u "$(id -u)" -f "${esc_ws}/bin/llama-server" 2>/dev/null && stopped=1 || true
    pkill -u "$(id -u)" -f "(^|/)[Pp]ython[0-9.]* .*${esc_repo}/gateway/sse_gateway\.py" 2>/dev/null && stopped=1 || true
    if [[ "${#pids_to_wait[@]}" -gt 0 ]]; then
        for _ in $(seq 1 20); do
            local alive=0
            for wp in "${pids_to_wait[@]}"; do
                if kill -0 "$wp" 2>/dev/null; then
                    alive=1
                    break
                fi
            done
            [[ "$alive" -eq 0 ]] && break
            sleep 0.25
        done
        for wp in "${pids_to_wait[@]}"; do
            if kill -0 "$wp" 2>/dev/null; then
                kill -9 "$wp" 2>/dev/null || true
            fi
        done
    fi
    if [[ "$stopped" -eq 1 ]]; then
        echo -e "${GREEN}[✓] Stopped llama-server and sse_gateway.${RESET}"
    else
        echo -e "${YELLOW}[i] No running background instances found.${RESET}"
    fi
}

