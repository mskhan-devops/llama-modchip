cmd_tui() {
    local model="${1:-$DEFAULT_MODEL}"
    exec python3 "${REPO_ROOT}/scripts/llama_modchip.py" --model "$model" --port "$SERVER_PORT" --tui
}

cmd_help() {
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

SUBCMD="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$SUBCMD" in
    setup|install)   cmd_setup "$@" ;;
    download-bin|bin) cmd_download_bin "$@" ;;
    start|up|run)    cmd_start "$@" ;;
    stop|down)       cmd_stop ;;
    restart)         cmd_stop; cmd_start "$@" ;;
    chat|ask)        cmd_chat "$@" ;;
    bench|benchmark) cmd_bench "$@" ;;
    eval|gate)       cmd_eval "$@" ;;
    quantize)        cmd_quantize "$@" ;;
    web|ui)          cmd_web "$@" ;;
    claude)          cmd_claude "$@" ;;
    status|info)     cmd_status ;;
    checksums|sha256) cmd_checksums ;;
    tui)             cmd_tui "$@" ;;
    -h|--help|help)  cmd_help ;;
    *)
        echo -e "${YELLOW}[!] Unknown command: ${SUBCMD}${RESET}"
        cmd_help
        exit 1
        ;;
esac
